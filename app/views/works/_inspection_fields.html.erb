<% work.prepare_inspections %>
<section class="card mb-4">
  <div class="card-body">
    <h2 class="h5">Inspección del trabajo</h2>
    <p class="text-muted">Selecciona una inspección. Puedes guardar respuestas pendientes y continuar después.</p>
    <%= f.label :inspection_type, "Tipo de inspección", class: "form-label" %>
    <%= f.select :inspection_type, WorkInspection::CATALOG.map { |key, template| [template["title"], key] }, { include_blank: "Informe técnico libre (sin inspección)" }, class: "form-select mb-3", data: { inspection_select: true } %>
    <%= f.fields_for :inspections do |inspection_fields| %>
      <% inspection = inspection_fields.object %>
      <% selected = inspection.template_key == work.inspection_type %>
      <div class="border rounded p-3 mb-3" data-inspection="<%= inspection.template_key %>" <%= "hidden" unless selected %>>
        <%= inspection_fields.hidden_field :template_key %>
        <%= inspection_fields.hidden_field :enabled, value: selected ? "1" : "0", data: { inspection_enabled: true } %>
        <h3 class="h6"><%= inspection.title %></h3>
        <fieldset id="inspection-<%= inspection.template_key %>" class="mt-3" data-inspection-questions <%= "disabled" unless selected %>>
          <legend class="visually-hidden"><%= inspection.title %></legend>
          <%= inspection_fields.fields_for :items do |item_fields| %>
            <% item = item_fields.object %>
            <div class="border-top pt-3 mt-3">
              <%= item_fields.hidden_field :position %>
              <p class="fw-semibold"><%= item.position + 1 %>. <%= item.question %></p>
              <div class="row g-2">
                <div class="col-md-3">
                  <%= item_fields.label :answer, "Resultado", class: "form-label" %>
                  <%= item_fields.select :answer, WorkInspectionItem::ANSWERS.map { |value, label| [label, value] }, { include_blank: "Sin responder" }, class: "form-select" %>
                </div>
                <div class="col-md-5">
                  <%= item_fields.label :observations, "Observaciones", class: "form-label" %>
                  <%= item_fields.text_area :observations, rows: 2, class: "form-control" %>
                </div>
                <div class="col-md-4">
                  <%= item_fields.label :fotos_uploads, "Fotos del ítem", class: "form-label" %>
                  <%= item_fields.file_field :fotos_uploads, multiple: true, accept: "image/png,image/jpeg,image/webp", class: "form-control", data: { compress_photo: true } %>
                  <% item.fotos.each do |photo| %>
                    <%= link_to photo.filename, rails_blob_path(photo, disposition: "inline"), class: "d-block small", target: "_blank", rel: "noopener" %>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </fieldset>
      </div>
    <% end %>
  </div>
</section>

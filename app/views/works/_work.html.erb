<div id="<%= dom_id(work) %>" class="card mb-3 shadow-sm">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start mb-2">
      <% if work.nombre.present? %>
        <h2 class="h5 card-title mb-0"><%= work.nombre %></h2>
      <% end %>
      <% if work.fecha.present? %>
        <span class="badge text-bg-light"><%= work.fecha.strftime("%d-%m-%Y") %></span>
      <% end %>
    </div>
    <p class="text-muted small">Informe N° <%= work.id %></p>
    <div class="row gy-3">
      <% { area: "Área", tag: "Tag del equipo", planta: "Planta", numero_cotizacion: "N° Cotización", solicita: "Solicita", supervisor: "Supervisor", hora_inicio: "Hora inicio", hora_termino: "Hora término" }.each do |field, label| %>
        <% value = work.public_send(field) %>
        <% next if value.blank? %>
        <div class="col-md-6">
          <div class="small text-muted"><%= label %></div>
          <div class="fw-semibold"><%= %i[hora_inicio hora_termino].include?(field) ? value.strftime("%H:%M") : value %></div>
        </div>
      <% end %>
      <% { seguridad: "Seguridad y medio ambiente", descripcion: "Trabajo realizado", personal: "Personal", repuestos: "Repuestos", epp: "EPP", hallazgos: "Hallazgos", observaciones: "Observaciones" }.each do |field, label| %>
        <% next if work.public_send(field).blank? %>
        <div class="col-12">
          <div class="small text-muted"><%= label %></div>
          <%= simple_format(work.public_send(field)) %>
        </div>
      <% end %>
    </div>
    <% unless local_assigns[:read_only] %>
      <div class="mt-3 d-flex gap-2">
        <%= link_to "Editar", edit_work_path(work), class: "btn btn-sm btn-outline-secondary" %>
        <%= link_to "Correo", email_work_path(work), class: "btn btn-sm btn-outline-primary" %>
        <%= link_to "Eliminar", work, data: { turbo_method: :delete, turbo_confirm: "¿Eliminar este informe técnico?" }, class: "btn btn-sm btn-outline-danger" %>
      </div>
    <% end %>
  </div>
</div>

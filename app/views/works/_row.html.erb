<tr id="<%= dom_id(work) %>">
  <td><%= work.fecha&.strftime("%d-%m-%Y") %></td>
  <td><%= work.planta %></td>
  <td><%= work.area %></td>
  <td><%= work.tag %></td>
  <td><%= work.numero_cotizacion %></td>
  <td><%= work.solicita %></td>
  <td><%= work.supervisor %></td>
  <td><%= work.hora_inicio&.strftime("%H:%M") %></td>
  <td><%= work.hora_termino&.strftime("%H:%M") %></td>
  <td><%= truncate(work.nombre.to_s, length: 24) %></td>

  <td>
    <div class="d-flex gap-2">
      <% { fotos_antes: "Antes", fotos_despues: "Después", fotos: "Adicionales" }.each do |campo, etiqueta| %>
        <% fotos = work.public_send(campo) %>
        <div class="d-flex flex-column align-items-center gap-1">
          <span class="badge text-bg-light"><%= etiqueta %>: <%= fotos.size %></span>
          <% if fotos.attached? %>
            <%= link_to work_path(work), title: "Ver imágenes: #{etiqueta}" do %>
              <%= image_tag fotos.first.variant(resize_to_fill: [60, 60]),
                            width: 60, height: 60, loading: "lazy",
                            class: "rounded border",
                            alt: "#{etiqueta}: #{fotos.first.filename}" %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </td>

  <td class="text-end">
    <div class="btn-group btn-group-sm" role="group">
      <%= link_to "Ver", work_path(work), class: "btn btn-outline-primary" %>
      <%= link_to "Editar", edit_work_path(work), class: "btn btn-outline-secondary" %>
      <%= link_to email_work_path(work), class: "btn btn-outline-primary", title: "Enviar informe por correo" do %>
        <i class="bi bi-envelope" aria-hidden="true"></i> Correo
      <% end %>
      <%= link_to "Eliminar",
                  work_path(work),
                  data: { turbo_method: :delete, turbo_confirm: "¿Eliminar este informe técnico?" },
                  class: "btn btn-outline-danger" %>
    </div>
  </td>
</tr>

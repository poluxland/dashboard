<tr id="<%= dom_id(work) %>">
  <td class="text-nowrap"><%= work.fecha&.strftime("%d-%m-%Y") %></td>
  <td><%= link_to work.nombre.presence || "Informe sin título", work_path(work) %></td>
  <td><%= work.planta %><div class="small text-muted"><%= work.area %></div></td>
  <td><%= work.tag %></td>
  <td>
    <% if work.selected_inspections.empty? %>
      <span class="text-muted">Informe libre</span>
    <% end %>
    <% work.selected_inspections.each do |inspection| %>
      <% summary = inspection.summary %>
      <div class="mb-2">
        <div class="small fw-semibold"><%= inspection.title %></div>
        <span class="badge text-bg-<%= summary[:failed].positive? ? 'danger' : (summary[:state] == 'Cumple' ? 'success' : 'secondary') %>"><%= summary[:state] %></span>
        <div class="small"><%= summary[:reviewed] %>/<%= summary[:total] %> revisados · <%= summary[:failed] %> no cumplen</div>
        <% if summary[:compliance] %>
          <div class="small"><%= summary[:compliance] %>% cumplimiento<%= " (provisional)" if summary[:reviewed] < summary[:total] %></div>
        <% end %>
      </div>
    <% end %>
  </td>

  <td>
    <div class="d-flex flex-wrap gap-2">
      <% { fotos_antes: "Antes", fotos_despues: "Después", fotos: "Adicionales" }.each do |campo, etiqueta| %>
        <% fotos = work.public_send(campo) %>
        <div class="d-flex flex-column align-items-center gap-1">
          <span class="badge text-bg-light"><%= etiqueta %>: <%= fotos.size %></span>
          <% if fotos.attached? %>
            <%= link_to work_path(work), title: "Ver imágenes: #{etiqueta}" do %>
              <%= image_tag fotos.first.variant(resize_to_fill: [60, 60]),
                            width: 60, height: 60, loading: "lazy",
                            class: "rounded border",
                            alt: "#{etiqueta}: #{fotos.first.filename}" %>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <span class="badge text-bg-light align-self-start">Inspecciones: <%= work.selected_inspections.sum { |inspection| inspection.items.sum { |item| item.fotos.size } } %></span>
    </div>
  </td>

  <td class="text-end">
    <div class="btn-group btn-group-sm" role="group">
      <%= link_to "Ver", work_path(work), class: "btn btn-outline-primary" %>
      <%= link_to "Editar", edit_work_path(work), class: "btn btn-outline-secondary" %>
      <%= link_to email_work_path(work), class: "btn btn-outline-primary", title: "Enviar informe por correo" do %>
        <i class="bi bi-envelope" aria-hidden="true"></i> Correo
      <% end %>
      <%= link_to "Eliminar",
                  work_path(work),
                  data: { turbo_method: :delete, turbo_confirm: "¿Eliminar este informe técnico?" },
                  class: "btn btn-outline-danger" %>
    </div>
  </td>
</tr>

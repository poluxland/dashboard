<tr id="<%= dom_id(work) %>">
  <td><%= work.fecha&.strftime("%d-%m-%Y") %></td>
  <td><%= work.planta %></td>
  <td><%= work.area %></td>
  <td><%= work.tag %></td>
  <td><%= work.numero_cotizacion %></td>
  <td><%= work.solicita %></td>
  <td><%= work.supervisor %></td>
  <td><%= work.hora_inicio&.strftime("%H:%M") %></td>
  <td><%= work.hora_termino&.strftime("%H:%M") %></td>
  <td><%= truncate(work.nombre.to_s, length: 24) %></td>

  <td>
    <% { fotos_antes: "Antes", fotos_despues: "Después", fotos: "Adicionales" }.each do |campo, etiqueta| %>
      <span class="badge text-bg-light"><%= etiqueta %>: <%= work.public_send(campo).size %></span>
    <% end %>
  </td>

  <td class="text-end">
    <div class="btn-group btn-group-sm" role="group">
      <%= link_to "Ver", work_path(work), class: "btn btn-outline-primary" %>
      <%= link_to "Editar", edit_work_path(work), class: "btn btn-outline-secondary" %>
      <%= link_to "Eliminar",
                  work_path(work),
                  data: { turbo_method: :delete, turbo_confirm: "¿Eliminar este informe técnico?" },
                  class: "btn btn-outline-danger" %>
    </div>
  </td>
</tr>

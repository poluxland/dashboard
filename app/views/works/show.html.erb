<% content_for :title, "Informe técnico de mantenimiento ##{@work.id}" %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <div class="d-flex align-items-center gap-3">
    <%= image_tag "impromaq-logo.png", alt: "Logo Impromaq", width: 56, height: 56, class: "rounded flex-shrink-0" %>
    <h1 class="h3 mb-0">Informe técnico de mantenimiento · Impromaq</h1>
  </div>
  <%= link_to "Volver a informes", works_path, class: "btn btn-outline-secondary" %>
</div>
<div class="d-flex flex-wrap gap-2 mb-3">
  <%= button_to "Enviar a José, Julio y Fernando", send_email_work_path(@work), params: { delivery: "team" }, class: "btn btn-primary", data: { turbo_submits_with: "Enviando…" } %>
  <%= link_to "Enviar a otros correos", email_work_path(@work), class: "btn btn-outline-primary" %>
</div>
<%= render @work %>
<%= render "inspection_report", work: @work %>
<%= render "photo_report", work: @work %>

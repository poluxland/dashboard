<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h4 mb-0">Trabajos e inspecciones</h1>
  <%= link_to "Nuevo informe", new_work_path, class: "btn btn-primary" %>
</div>

<%= form_with url: works_path, method: :get, class: "row g-2 mb-3" do |f| %>
  <div class="col-md-3">
    <%= f.label :inspection_type, "Tipo de inspección", class: "form-label" %>
    <%= f.select :inspection_type, WorkInspection::CATALOG.map { |key, template| [template["title"], key] }, { include_blank: "Todas", selected: params[:inspection_type] }, class: "form-select" %>
  </div>
  <div class="col-md-2">
    <%= f.label :inspection_state, "Estado", class: "form-label" %>
    <%= f.select :inspection_state, ["Sin iniciar", "Incompleta", "Con hallazgos", "Cumple", "No aplica"], { include_blank: "Todos", selected: params[:inspection_state] }, class: "form-select" %>
  </div>
  <% { planta: "Planta", area: "Área", tag: "Equipo / Tag" }.each do |field, label| %>
    <div class="col-md-2">
      <%= f.label field, label, class: "form-label" %>
      <%= f.text_field field, value: params[field], class: "form-control" %>
    </div>
  <% end %>
  <div class="col-md-1 d-flex align-items-end"><%= f.submit "Filtrar", class: "btn btn-outline-primary" %></div>
  <div class="col-12"><%= link_to "Limpiar filtros", works_path %></div>
<% end %>

<div class="table-responsive">
  <table class="table table-sm table-striped table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th>Fecha</th>
        <th>Intervención</th>
        <th>Planta / Área</th>
        <th>Equipo / Tag</th>
        <th>Inspecciones y avance</th>
        <th>Fotos</th>
        <th class="text-end">Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% if @works.empty? %>
        <tr><td colspan="7" class="text-muted p-4">No hay trabajos para estos filtros.</td></tr>
      <% end %>
      <% @works.each do |work| %>
        <%= render partial: "row", locals: { work: work } %>
      <% end %>
    </tbody>
  </table>
</div>

<%# Si usas Pagy %>
<% if defined?(pagy_nav) && @pagy.present? %>
  <div class="mt-3">
    <%= pagy_nav(@pagy) %>
  </div>
<% end %>

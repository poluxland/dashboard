<% content_for :title, "Enviar informe por correo" %>
<div class="card shadow-sm mx-auto my-4" style="max-width: 640px;">
  <div class="card-body p-4">
    <h1 class="h4">Enviar informe por correo</h1>
    <p class="text-muted">Informe N° <%= @work.id %> · <%= @work.nombre.presence || "Sin título" %></p>
    <p>El correo incluye el informe, miniaturas de las fotos y enlaces para abrir el reporte completo.</p>
    <div class="border rounded p-3 mb-4">
      <h2 class="h6">Enviar al equipo</h2>
      <p class="small text-muted"><%= WorkMailer::TEAM_RECIPIENTS.join(" · ") %></p>
      <%= button_to "Enviar a José, Julio y Fernando", send_email_work_path(@work), params: { delivery: "team" }, class: "btn btn-primary", data: { turbo_submits_with: "Enviando…" } %>
    </div>
    <h2 class="h6">Enviar a otros destinatarios</h2>
    <%= form_with url: send_email_work_path(@work), method: :post do |form| %>
      <div class="mb-3">
        <%= form.label :recipient, "Correos de los destinatarios", class: "form-label" %>
        <%= form.text_field :recipient, value: @recipient, required: true, class: "form-control", placeholder: "nombre@empresa.cl, otro@empresa.cl", aria: { describedby: "recipient-help" } %>
        <p id="recipient-help" class="small text-muted">Separa los correos con coma o punto y coma. Hasta 20 destinatarios.</p>
      </div>
      <p class="small text-muted">Máximo 15 MB de fotografías en total por envío.</p>
      <div class="d-flex gap-2">
        <%= form.submit "Enviar a los correos indicados", class: "btn btn-outline-primary", data: { turbo_submits_with: "Enviando…" } %>
        <%= link_to "Cancelar", work_path(@work), class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>

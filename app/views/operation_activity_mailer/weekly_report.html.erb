<div style="margin:0;background:#f3f4f6;padding:24px 12px;font-family:Arial,Helvetica,sans-serif;color:#111827;">
  <div style="max-width:760px;margin:0 auto;background:#ffffff;border-radius:16px;overflow:hidden;">
    <div style="background:#111827;color:#ffffff;padding:24px;">
      <h1 style="font-size:24px;margin:0 0 8px;"><%= @report.title %></h1>
      <div style="color:#d1d5db;">Puerto Montt · <%= l(@report.start_date, format: :long) %> al <%= l(@report.end_date, format: :long) %></div>
    </div>
    <div style="padding:24px;">
      <% average = @report.average_state %>
      <% metrics = @report.summary_counts.merge("Avance promedio" => average ? number_to_percentage(average, precision: 1, strip_insignificant_zeros: true) : "—") %>
      <table width="100%" style="border-collapse:collapse;">
        <tbody>
          <% metrics.each do |label, value| %>
            <tr>
              <th scope="row" style="text-align:left;padding:6px 12px;background:#f3f4f6;font-weight:normal;"><%= label %></th>
              <td style="text-align:right;padding:6px 12px;background:#f3f4f6;font-weight:bold;"><%= value %></td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <% if @report.records.empty? %>
        <p>No se registraron actividades durante esta semana.</p>
      <% else %>
        <% { "Estado de ejecución" => @report.state_counts, "Actividades por área" => @report.area_counts }.each do |title, counts| %>
          <h2 style="font-size:17px;margin:24px 0 8px;"><%= title %></h2>
          <table width="100%" style="border-collapse:collapse;">
            <tbody>
              <% counts.each do |label, count| %>
                <tr>
                  <th scope="row" style="text-align:left;padding:5px 0;font-weight:normal;"><%= label %></th>
                  <td style="text-align:right;font-weight:bold;"><%= count %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>

        <h2 style="font-size:17px;margin:24px 0 8px;">Actividades de la semana</h2>
        <% @report.records.each do |record| %>
          <div style="border-top:1px solid #e5e7eb;padding:10px 0;">
            <div style="font-weight:bold;"><%= record.actividad %></div>
            <div style="color:#475569;font-size:13px;margin-top:4px;">
              <%= l(record.fecha, format: :short) %> · <%= record.area %> · <%= record.tipo %> · <%= number_to_percentage(record.estado, precision: 2, strip_insignificant_zeros: true) %>
            </div>
          </div>
        <% end %>
      <% end %>

      <p style="text-align:center;margin:24px 0 0;">
        <%= link_to "Ver informe en el dashboard", operation_activities_url(semana: @report.start_date),
                    style: "display:inline-block;background:#2563eb;color:#ffffff;text-decoration:none;font-weight:bold;padding:12px 18px;border-radius:8px;" %>
      </p>
    </div>
  </div>
</div>

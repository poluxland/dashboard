<article <% if local_assigns[:draggable] %>draggable="true" data-task-card data-task-url="<%= task_path(task) %>" data-task-status="<%= task.status %>" data-action="dragstart->task-board#start dragend->task-board#end"<% end %> class="card border-0 shadow-sm mb-3" style="border-radius: 12px; border-top: 4px solid <%= task.priority == 'normal' ? '#537ae9' : '#dc3545' %> !important">
  <div class="card-body">
    <div class="d-flex justify-content-between gap-2 mb-2"><span class="badge text-bg-light"><%= Task::STATUSES[task.status] %></span><span class="badge <%= task.priority == 'normal' ? 'text-bg-light' : 'text-bg-danger' %>"><%= Task::PRIORITIES[task.priority] %></span></div>
    <h3 class="h6"><%= link_to task.title, task_path(task), class: "text-decoration-none text-reset" %></h3>
    <p class="small"><span class="badge text-bg-light"><%= Task::CATEGORIES[task.category] %></span> <span class="badge text-bg-light"><%= task.plant %></span></p>
    <% if task.description.present? %><div class="small text-muted mb-3" style="white-space: pre-wrap; overflow-wrap: anywhere"><%= task.description %></div><% end %>
    <p class="small mb-2 text-break"><i class="bi bi-person"></i> <%= task.assignee_email %></p>
    <p class="small <%= task.due_on && task.due_on < Time.current.in_time_zone('America/Santiago').to_date && task.status != 'done' ? 'text-danger' : 'text-muted' %>"><%= task.due_on ? "Fecha límite: #{task.due_on.strftime('%d/%m/%Y')}" : 'Sin fecha límite' %></p>
    <%= render "tasks/checklist", task: task %>
    <%= form_with model: task, class: "d-flex gap-2" do |f| %>
      <%= f.select :status, Task::STATUSES.map { |value, label| [label, value] }, {}, class: "form-select form-select-sm", aria: { label: "Estado de #{task.title}" } %>
      <%= f.submit "Actualizar", class: "btn btn-sm btn-outline-primary" %>
    <% end %>
    <% if task_admin? %><%= link_to "Editar tarea", edit_task_path(task), class: "btn btn-sm btn-outline-primary mt-2" %><% end %>
  </div>
</article>

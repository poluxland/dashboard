<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3">Tablero de tareas</h1><p class="text-muted mb-0">Organiza el equipo por estado, planta o clase. En la vista por estado puedes arrastrar las tarjetas.</p></div><%= link_to "Nueva tarea", new_task_path, class: "btn btn-primary" %></div>
<%= form_with url: tasks_path, method: :get, class: "d-flex gap-2 mb-4", data: { controller: "task-filters", action: "change->task-filters#apply" } do |f| %><%= f.select :assignee, @assignees, { include_blank: "Todo el equipo", selected: params[:assignee] }, class: "form-select", aria: { label: "Responsable" } %><%= f.select :group_by, [["Por estado", "status"], ["Por planta", "plant"], ["Por clase", "category"]], { selected: @group_by }, class: "form-select", aria: { label: "Agrupar tareas" } %><noscript><%= f.submit "Filtrar", class: "btn btn-outline-primary" %></noscript><% end %>
<div data-controller="task-board"><p role="status" aria-live="polite" class="small text-muted"></p><div class="row g-3"><% @groups.each do |status, label| %><%= render "tasks/column", title: label, board_status: (@group_by == "status" ? status : nil), tasks: @tasks.select { |task| task.public_send(@group_by) == status } %><% end %></div>
</div>

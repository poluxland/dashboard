<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3">Tablero de tareas</h1><p class="text-muted mb-0">Administra y asigna el trabajo del equipo.</p></div><%= link_to "Nueva tarea", new_task_path, class: "btn btn-primary" %></div>
<%= form_with url: tasks_path, method: :get, class: "d-flex gap-2 mb-4" do |f| %><%= f.select :assignee, @assignees, { include_blank: "Todo el equipo", selected: params[:assignee] }, class: "form-select", aria: { label: "Responsable" } %><%= f.submit "Filtrar", class: "btn btn-outline-primary" %><% end %>
<div class="row g-3"><% Task::STATUSES.each do |status, label| %><%= render "tasks/column", title: label, tasks: @tasks.select { |task| task.status == status } %><% end %></div>

<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3">Tablero de tareas</h1><p class="text-muted mb-0">Arrastra las tarjetas entre columnas para cambiar su estado.</p></div><%= link_to "Nueva tarea", new_task_path, class: "btn btn-primary" %></div>
<%= form_with url: tasks_path, method: :get, class: "d-flex gap-2 mb-4" do |f| %><%= f.select :assignee, @assignees, { include_blank: "Todo el equipo", selected: params[:assignee] }, class: "form-select", aria: { label: "Responsable" } %><%= f.submit "Filtrar", class: "btn btn-outline-primary" %><% end %>
<div data-controller="task-board"><p role="status" aria-live="polite" class="small text-muted"></p><div class="row g-3"><% Task::STATUSES.each do |status, label| %><%= render "tasks/column", title: label, board_status: status, tasks: @tasks.select { |task| task.status == status } %><% end %></div>
</div>

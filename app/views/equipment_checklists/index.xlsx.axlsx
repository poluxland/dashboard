workbook = xlsx_package.workbook
header = workbook.styles.add_style(b: true, fg_color: "FFFFFF", bg_color: "183153", alignment: { wrap_text: true })

workbook.add_worksheet(name: "Checklists", escape_formulas: true) do |sheet|
  sheet.add_row [
    "N.º Dashboard", "N.º ERP", "Fecha (Chile)", "Equipo", "Código histórico", "Planta", "Operador", "Horómetro",
    "Resultado", *EquipmentChecklist::QUESTIONS.values, "Comentarios"
  ], style: header

  @checklists.each do |record|
    sheet.add_row [
      record.id, record.erp_id, record.created_at.in_time_zone("America/Santiago").strftime("%d/%m/%Y %H:%M"),
      record.asset_label, record.legacy_code, record.plant_label, record.operator, record.hour_meter,
      EquipmentChecklist::STATUSES.fetch(record.status_key).first,
      *EquipmentChecklist::QUESTIONS.keys.map { |field| EquipmentChecklist::ANSWERS.fetch(record[field], record[field]) },
      record.comments
    ]
  end

  sheet.column_widths 14, 14, 20, 20, 20, 22, 26, 14, 30, *Array.new(16, 20), 55
  sheet.auto_filter = "A1:Z#{sheet.rows.size}"
  sheet.sheet_view.pane do |pane|
    pane.top_left_cell = "A2"
    pane.state = :frozen
    pane.y_split = 1
  end
end

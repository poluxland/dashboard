<%= form_with model: @checklist do |f| %>
  <%= render "equipment_checklists/errors", record: @checklist %>
  <%= render "asset_picker", f: f %>

  <div class="row g-3 mb-3">
    <div class="col-sm-8">
      <%= f.label :operator, "Operador", class: "form-label" %>
      <%= f.text_field :operator, required: @checklist.new_record? || @checklist.operator.present?, class: "form-control", autocomplete: "name" %>
    </div>
    <div class="col-sm-4">
      <%= f.label :hour_meter, "Horómetro", class: "form-label" %>
      <%= f.number_field :hour_meter, min: 0, step: 1, inputmode: "numeric", required: @checklist.new_record? || @checklist.hour_meter.present?, class: "form-control" %>
    </div>
  </div>
  <fieldset class="card card-body mb-4">
    <legend class="h5">Planta</legend>
    <% plants = EquipmentChecklist::PLANTS.dup %>
    <% plants[@checklist.c17] ||= @checklist.c17 if @checklist.c17.present? %>
    <%= render "choices", f: f, field: :c17, options: plants, required: @checklist.new_record? %>
  </fieldset>
  <h2 class="h5 mt-4">Puntos de inspección</h2>
  <% EquipmentChecklist::QUESTIONS.each do |field, question| %>
    <fieldset class="card card-body mb-3">
      <legend class="fs-6 fw-semibold"><%= question %></legend>
      <% answers = EquipmentChecklist::ANSWERS.dup %>
      <% value = @checklist[field] %>
      <% answers[value] ||= value if value.present? %>
      <%= render "choices", f: f, field: field, options: answers, required: @checklist.new_record? %>
    </fieldset>
  <% end %>
  <div class="mb-3">
    <%= f.label :comments, "Comentarios", class: "form-label" %>
    <%= f.text_area :comments, rows: 3, class: "form-control" %>
  </div>
  <%= f.submit "Guardar checklist", class: "btn btn-primary w-100 py-2" %>
<% end %>

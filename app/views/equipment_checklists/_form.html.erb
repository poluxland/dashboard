<%= form_with model: @checklist do |f| %>
  <%= render "equipment_checklists/errors", record: @checklist %>
  <fieldset class="card card-body mb-3" data-controller="equipment-picker">
    <legend class="h5">Equipo</legend>
    <% if @assets.any? %>
      <label for="equipment-search" class="form-label">Buscar por código, marca o modelo</label>
      <input type="search" id="equipment-search" class="form-control mb-2" autocomplete="off"
             data-equipment-picker-target="search" data-action="input->equipment-picker#filter">
      <% if @checklist.legacy_code.present? && @checklist.mobile_asset_id.nil? %>
        <p class="small text-body-secondary">Código del registro histórico: <%= @checklist.legacy_code %></p>
      <% end %>
      <div class="equipment-choices equipment-picker-options">
        <% @assets.each do |asset| %>
          <% id = "equipment_checklist_mobile_asset_id_#{asset.id}" %>
          <label class="equipment-choice" for="<%= id %>" data-equipment-picker-target="option" data-search="<%= [asset.label, asset.brand, asset.model, asset.plant].compact.join(" ") %>">
            <%= f.radio_button :mobile_asset_id, asset.id, id: id, required: @checklist.new_record?, class: "form-check-input",
                               data: { action: "change->equipment-picker#filter" } %>
            <%= asset.label %>
          </label>
        <% end %>
        <p hidden class="small mb-0" data-equipment-picker-target="empty" role="status">No se encontraron equipos con esa búsqueda.</p>
      </div>
    <% else %>
      <p class="mb-0">Primero registra un equipo en el <%= link_to "catálogo de equipos", mobile_assets_path %>.</p>
    <% end %>
  </fieldset>

  <div class="row g-3 mb-3">
    <div class="col-sm-8">
      <%= f.label :operator, "Operador", class: "form-label" %>
      <%= f.text_field :operator, required: @checklist.new_record? || @checklist.operator.present?, class: "form-control", autocomplete: "name" %>
    </div>
    <div class="col-sm-4">
      <%= f.label :hour_meter, "Horómetro", class: "form-label" %>
      <%= f.number_field :hour_meter, min: 0, step: 1, inputmode: "numeric", required: @checklist.new_record? || @checklist.hour_meter.present?, class: "form-control" %>
    </div>
  </div>
  <fieldset class="card card-body mb-4">
    <legend class="h5">Planta</legend>
    <% plants = EquipmentChecklist::PLANTS.dup %>
    <% plants[@checklist.c17] ||= @checklist.c17 if @checklist.c17.present? %>
    <%= render "choices", f: f, field: :c17, options: plants, required: @checklist.new_record? %>
  </fieldset>
  <h2 class="h5 mt-4">Puntos de inspección</h2>
  <% EquipmentChecklist::QUESTIONS.each do |field, question| %>
    <fieldset class="card card-body mb-3">
      <legend class="fs-6 fw-semibold"><%= question %></legend>
      <% answers = EquipmentChecklist::ANSWERS.dup %>
      <% value = @checklist[field] %>
      <% answers[value] ||= value if value.present? %>
      <%= render "choices", f: f, field: field, options: answers, required: @checklist.new_record? %>
    </fieldset>
  <% end %>
  <div class="mb-3">
    <%= f.label :comments, "Comentarios", class: "form-label" %>
    <%= f.text_area :comments, rows: 3, class: "form-control" %>
  </div>
  <%= f.submit "Guardar checklist", class: "btn btn-primary w-100 py-2" %>
<% end %>

<% content_for :title, "Historial de soplado TC" %>

<section class="py-2">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="h3 mb-0">Historial de soplado TC</h1>
    <div class="d-flex flex-wrap gap-2">
      <%= link_to "Gráficos", graficos_soplados_path, class: "btn btn-outline-primary" %>
      <%= link_to "Nuevo registro", new_soplado_path, class: "btn btn-primary" %>
    </div>
  </div>

  <%= form_with url: soplados_path, method: :get, class: "card card-body mb-3" do %>
    <div class="row g-3 align-items-end">
      <div class="col-md-4">
        <%= label_tag :supervisor, "Supervisor", class: "form-label" %>
        <%= search_field_tag :supervisor, @filters[:supervisor], class: "form-control" %>
      </div>
      <div class="col-6 col-md-2">
        <%= label_tag :desde, "Desde", class: "form-label" %>
        <%= date_field_tag :desde, @filters[:desde], class: "form-control" %>
      </div>
      <div class="col-6 col-md-2">
        <%= label_tag :hasta, "Hasta", class: "form-label" %>
        <%= date_field_tag :hasta, @filters[:hasta], class: "form-control" %>
      </div>
      <div class="col-md-auto">
        <%= submit_tag "Filtrar", class: "btn btn-outline-primary" %>
        <%= link_to "Limpiar", soplados_path, class: "btn btn-link" if @filters.values.any?(&:present?) %>
      </div>
    </div>
  <% end %>

  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
    <p class="text-body-secondary mb-0"><%= number_with_delimiter(@pagy.count, delimiter: ".") %> registros</p>
    <% if @pagy.count.positive? %>
      <div class="d-flex flex-wrap gap-2">
        <%= link_to "Excel", soplados_path(@filters.to_h.merge(format: :xlsx)), class: "btn btn-sm btn-outline-secondary", data: { turbo: false } %>
        <%= link_to "CSV", soplados_path(@filters.to_h.merge(format: :csv)), class: "btn btn-sm btn-outline-secondary", data: { turbo: false } %>
        <%= link_to "Imprimir / PDF", soplados_path(@filters.to_h.merge(vista: "impresion")), class: "btn btn-sm btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
  <% if @soplados.any? %>
    <%= render "table", soplados: @soplados, actions: true %>
    <div class="mt-3"><%== pagy_bootstrap_nav(@pagy) if @pagy.pages > 1 %></div>
  <% else %>
    <p class="text-body-secondary">Sin registros para los filtros seleccionados.</p>
  <% end %>
</section>

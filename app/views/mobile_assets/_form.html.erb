<%= form_with model: @asset do |f| %>
  <%= render "equipment_checklists/errors", record: @asset %>
  <div class="row g-3 mb-3">
    <% { code: "Código", brand: "Marca", model: "Modelo", plant: "Planta" }.each do |field, label| %>
      <div class="col-sm-6">
        <%= f.label field, label, class: "form-label" %>
        <%= f.text_field field, class: "form-control", required: field == :code %>
      </div>
    <% end %>
    <div class="col-sm-6">
      <%= f.label :year, "Año", class: "form-label" %>
      <%= f.number_field :year, class: "form-control" %>
    </div>
    <div class="col-12">
      <%= f.label :notes, "Otros", class: "form-label" %>
      <%= f.text_area :notes, rows: 3, class: "form-control" %>
    </div>
  </div>
  <%= f.submit "Guardar equipo", class: "btn btn-primary" %>
<% end %>

<section class="container-xl py-4">
  <h1 class="h2 mb-3"><%= @asset.label %></h1>
  <%= render "equipment_checklists/navigation" %>
  <div class="card card-body mb-4">
    <dl class="row mb-0">
      <dt class="col-sm-4">Marca</dt><dd class="col-sm-8"><%= @asset.brand.presence || "—" %></dd>
      <dt class="col-sm-4">Modelo</dt><dd class="col-sm-8"><%= @asset.model.presence || "—" %></dd>
      <dt class="col-sm-4">Planta</dt><dd class="col-sm-8"><%= EquipmentChecklist::PLANTS[EquipmentChecklist.plant_code(@asset.plant)] || "—" %></dd>
      <dt class="col-sm-4">Año</dt><dd class="col-sm-8"><%= @asset.year || "—" %></dd>
      <dt class="col-sm-4">Otros</dt><dd class="col-sm-8"><%= simple_format(@asset.notes.presence || "—") %></dd>
    </dl>
    <div class="d-flex gap-2 flex-wrap">
      <%= link_to "Checklist de operador", new_equipment_checklist_path(asset_id: @asset.id), class: "btn btn-primary" %>
      <%= link_to "Checklist de mantenedor", new_maintenance_checklist_path(asset_id: @asset.id), class: "btn btn-outline-primary" %>
      <%= link_to "Editar equipo", edit_mobile_asset_path(@asset), class: "btn btn-outline-secondary" %>
      <% if @checklists.empty? %>
        <%= button_to "Eliminar equipo", @asset, method: :delete, class: "btn btn-outline-danger",
                      form: { data: { turbo_confirm: "¿Eliminar este equipo?" } } %>
      <% end %>
    </div>
  </div>
  <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
    <h2 class="h5 mb-0">Últimos checklists</h2>
    <%= link_to "Ver historial completo", report_equipment_checklists_path(asset_id: @asset.id), class: "btn btn-sm btn-outline-primary" %>
  </div>
  <%= render "equipment_checklists/report_table", checklists: @checklists %>
</section>

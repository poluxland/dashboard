<% content_for :title, "Horas extra PTM" %>
<div class="container-xl pb-4 pt-3">
  <header class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0">Horas extra PTM</h1>
    <div class="d-flex flex-wrap gap-2">
      <%= link_to "Descargar Excel", overtime_entries_path(@filters.to_h.symbolize_keys.merge(estado: @status, format: :xlsx)),
                  class: "btn btn-outline-success", data: { turbo: false } %>
      <% if @staff %>
        <%= link_to "Registrar horas", new_overtime_entry_path, class: "btn btn-primary" %>
      <% else %>
        <%= button_to "Cerrar sesión", overtime_logout_path, method: :delete, class: "btn btn-outline-secondary" %>
      <% end %>
    </div>
  </header>

  <%= form_with url: overtime_entries_path, method: :get, class: "row g-2 align-items-end mb-4", data: { turbo: false } do |form| %>
    <div class="col-12 col-md-3">
      <%= form.label :estado, "Estado", class: "form-label" %>
      <%= form.select :estado, [*OvertimeEntry::STATUSES, ["Sin estado", "sin_estado"], ["Todos", "todos"]], { selected: @status }, class: "form-select" %>
    </div>
    <div class="col-6 col-md-2">
      <%= form.label :from, "Desde", class: "form-label" %>
      <%= form.date_field :from, value: params[:from], class: "form-control" %>
    </div>
    <div class="col-6 col-md-2">
      <%= form.label :to, "Hasta", class: "form-label" %>
      <%= form.date_field :to, value: params[:to], class: "form-control" %>
    </div>
    <% if @global_review %>
      <div class="col-12 col-md-3">
        <%= form.label :mandante, "Mandante (ITO)", class: "form-label" %>
        <%= form.select :mandante, @mandantes, { include_blank: "Todos", selected: params[:mandante] }, class: "form-select" %>
      </div>
    <% end %>
    <div class="col-auto"><%= form.submit "Filtrar", class: "btn btn-outline-primary" %></div>
  <% end %>

  <% if @entries.any? %>
    <% reviewable = @entries.any? { |entry| entry.estado == OvertimeEntry::PENDING } %>
    <%= form_with url: review_overtime_entries_path, method: :patch, data: { turbo: false, controller: "overtime-review" } do |form| %>
      <% if reviewable %>
        <div class="row g-2 align-items-end bg-body-tertiary border rounded p-3 mb-3">
          <div class="col-12 col-md-4">
            <%= form.label :decision, "Cambiar estado de la selección", class: "form-label" %>
            <%= form.select :decision, [["Aprobar", "Aprobada"], ["Rechazar", "Rechazada"]], { include_blank: "Seleccionar" }, required: true, class: "form-select", data: { action: "change->overtime-review#showReason" } %>
          </div>
          <div class="col-12 col-md-5" data-overtime-review-target="reason">
            <%= form.label :reason, "Motivo del rechazo", class: "form-label" %>
            <%= form.text_field :reason, maxlength: 1000, class: "form-control" %>
          </div>
          <div class="col-auto"><%= form.submit "Aplicar a seleccionadas", class: "btn btn-primary" %></div>
        </div>
      <% end %>
      <div class="table-responsive border rounded bg-body">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <% if reviewable %>
                <th scope="col"><input type="checkbox" class="form-check-input" aria-label="Seleccionar los registros pendientes de esta página" data-overtime-review-target="all" data-action="change->overtime-review#toggleAll"></th>
              <% end %>
              <th scope="col">Fecha</th><th scope="col">OT</th><th scope="col">Personal</th><th scope="col">Mandante</th>
              <th scope="col">Área y detalle</th><th scope="col">Inicio</th><th scope="col">Término</th><th scope="col">HE</th>
              <th scope="col">Estado de pago</th><th scope="col">Estado</th>
              <% if @staff && reviewable %><th scope="col"><span class="visually-hidden">Editar</span></th><% end %>
            </tr>
          </thead>
          <tbody>
            <% @entries.each do |entry| %>
              <tr>
                <% if reviewable %>
                  <td>
                    <% if entry.estado == OvertimeEntry::PENDING %>
                      <%= check_box_tag "ids[]", entry.id, false, id: "overtime_entry_#{entry.id}", class: "form-check-input", aria: { label: "Seleccionar registro #{entry.erp_id || entry.id}" }, data: { overtime_review_target: "item", action: "change->overtime-review#updateAll" } %>
                    <% end %>
                  </td>
                <% end %>
                <td class="text-nowrap"><%= entry.fecha&.strftime("%d-%m-%Y") %></td>
                <td><%= entry.ot %></td>
                <td><%= entry.personal %></td>
                <td><%= entry.mandante %></td>
                <td style="min-width: 15rem">
                  <div class="fw-medium"><%= [entry.area, entry.lugar].compact_blank.join(" · ") %></div>
                  <%= entry.descripcion %>
                  <% if entry.traslado.present? %><div class="small text-body-secondary">Traslado · <%= entry.traslado %></div><% end %>
                </td>
                <td><%= overtime_time(entry.inicio) %></td>
                <td><%= overtime_time(entry.termino) %></td>
                <td class="text-nowrap"><%= overtime_quantity(entry.he) %></td>
                <td><%= entry.ep %></td>
                <td>
                  <span class="fw-medium text-nowrap"><%= entry.estado.presence || "Sin estado" %></span>
                  <% if (review = entry.overtime_reviews.max_by(&:created_at)) %>
                    <div class="small text-body-secondary"><%= review.reviewer_email %> · <%= review.created_at.in_time_zone("America/Santiago").strftime("%d-%m-%Y %H:%M") %></div>
                    <% if review.reason.present? %><div class="small"><%= review.reason %></div><% end %>
                  <% end %>
                </td>
                <% if @staff && reviewable %>
                  <td><%= link_to "Editar", edit_overtime_entry_path(entry) if entry.estado == OvertimeEntry::PENDING %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
    <div class="mt-3"><%== pagy_bootstrap_nav(@pagy) if @pagy.pages > 1 %></div>
  <% else %>
    <p class="text-body-secondary">No hay registros para estos filtros.</p>
  <% end %>
</div>

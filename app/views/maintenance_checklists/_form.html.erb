<%= form_with model: @checklist do |f| %>
  <%= render "equipment_checklists/errors", record: @checklist %>
  <%= render "equipment_checklists/asset_picker", f: f %>
  <div class="row g-3 mb-3">
    <div class="col-sm-8">
      <%= f.label :technician, "Nombre del mantenedor", class: "form-label" %>
      <%= f.text_field :technician, class: "form-control", autocomplete: "name" %>
    </div>
    <div class="col-sm-4">
      <%= f.label :hour_meter, "Horómetro", class: "form-label" %>
      <%= f.text_field :hour_meter, class: "form-control" %>
    </div>
  </div>
  <fieldset class="card card-body mb-4">
    <legend class="h5">Estado operativo</legend>
    <% statuses = MaintenanceChecklist::STATUSES.keys.index_with(&:itself) %>
    <% statuses[""] = "Sin registro" %>
    <% value = @checklist.operating_status.to_s %>
    <% statuses[value] ||= value if value.present? %>
    <%= render "equipment_checklists/choices", f: f, field: :operating_status, options: statuses, required: false %>
  </fieldset>
  <h2 class="h5">Puntos de revisión</h2>
  <% MaintenanceChecklist::QUESTIONS.each do |field, label| %>
    <fieldset class="card card-body mb-3">
      <legend class="fs-6 fw-semibold"><%= label %></legend>
      <%= render "equipment_checklists/choices", f: f, field: field,
                 options: MaintenanceChecklist::ANSWERS.except(nil), required: false %>
    </fieldset>
  <% end %>
  <h2 class="h5">Combustible y aceites</h2>
  <div class="row g-3 mb-4">
    <% MaintenanceChecklist::FLUIDS.each do |field, label| %>
      <div class="col-6">
        <%= f.label field, label, class: "form-label" %>
        <%= f.number_field field, step: 1, inputmode: "numeric", class: "form-control" %>
      </div>
    <% end %>
  </div>
  <%= f.submit "Guardar checklist", class: "btn btn-primary w-100 py-2" %>
<% end %>

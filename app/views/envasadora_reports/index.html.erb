<div class="d-flex justify-content-between flex-wrap gap-2 mb-3"><h1 class="h3">Reporte envasadora</h1><div class="d-flex gap-2"><%= link_to "Productividad y detenciones", envasadora_dashboard_path, class: "btn btn-outline-primary" %><%= link_to "Nuevo reporte", new_envasadora_report_path, class: "btn btn-primary" %></div></div>
<p><%= number_with_delimiter(@pagy.count, delimiter: ".") %> registros de medidas, inventario y operación, incluidos históricos importados.</p>
<%= form_with url: envasadora_reports_path, method: :get, data: { turbo: false }, class: "row g-2 align-items-end mb-3" do |form| %>
  <div class="col-sm-3"><%= form.label :from, "Desde", class: "form-label" %><%= form.date_field :from, value: params[:from], class: "form-control" %></div>
  <div class="col-sm-3"><%= form.label :to, "Hasta", class: "form-label" %><%= form.date_field :to, value: params[:to], class: "form-control" %></div>
  <div class="col-sm-3"><%= form.label :turno, "Turno", class: "form-label" %><%= form.select :turno, EnvasadoraReport::SHIFTS.keys, { include_blank: "Todos", selected: params[:turno] }, class: "form-select" %></div>
  <div class="col-sm-3 d-flex gap-2"><%= form.submit "Filtrar", class: "btn btn-primary" %><%= link_to "Limpiar", envasadora_reports_path, class: "btn btn-outline-secondary" %></div>
<% end %>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Fecha</th><th>Turno</th><th>Autor</th><th>Inventario (t)</th><th>Correo</th><th></th></tr></thead><tbody>
<% @reports.each do |report| %><tr><td><%= report.date %></td><td><%= report.turno %></td><td><%= report.author_email %></td><td><%= report.inventory_for_display.nil? ? "—" : envasadora_number(report.inventory_for_display) %></td><td><%= report.historical? ? "Histórico importado" : report.sent_at? ? "Enviado" : "Pendiente" %></td><td><%= link_to "Ver reporte", report %></td></tr><% end %>
<% if @reports.empty? %><tr><td colspan="6">Todavía no hay reportes.</td></tr><% end %>
</tbody></table></div>
<%== pagy_bootstrap_nav(@pagy) if @pagy.pages > 1 %>

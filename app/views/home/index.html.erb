<div class="mb-4"><h1 class="h3">Mis tareas</h1><p class="text-muted">Hola, <%= current_user[:name] %>. Este es tu trabajo pendiente.</p></div>
<%= form_with url: root_path, method: :get, class: "mb-4", data: { controller: "task-filters", action: "change->task-filters#apply" } do |f| %>
  <%= f.label :group_by, "Ver mis tareas", class: "form-label" %>
  <%= f.select :group_by, [["Por clase", "category"], ["Por planta", "plant"], ["Por estado", "status"], ["Por fecha", "date"]], { selected: @group_by }, class: "form-select", style: "max-width:320px" %>
  <noscript><%= f.submit "Aplicar", class: "btn btn-primary mt-2" %></noscript>
<% end %>
<div class="row g-3"><% @task_groups.each do |title, tasks| %><%= render "tasks/column", title: title, tasks: tasks, compact: true %><% end %></div>
<% unless @group_by == "status" %><details class="mt-4"><summary class="mb-3">Terminadas (<%= @completed_tasks.size %>)</summary><div class="row"><% @completed_tasks.each do |task| %><div class="col-12 col-lg-4"><%= render "tasks/card", task: task, compact: true %></div><% end %></div></details>

<% end %>

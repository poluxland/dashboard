<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Dashboard" %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
  <%= render "shared/navbar" if signed_in? %>

  <% if notice.present? || alert.present? %>
    <div class="app-flash-stack" aria-live="polite" aria-atomic="true">
      <% if notice.present? %>
        <div class="app-flash alert alert-success alert-dismissible fade show" role="status">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
      <% end %>

      <% if alert.present? %>
        <div class="app-flash alert alert-danger alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="container-fluid">
    <%= yield %>
  </div>
</body>

</html>

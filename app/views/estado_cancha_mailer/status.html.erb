<table role="presentation" width="100%" cellpadding="0" cellspacing="0" bgcolor="#edf3f8"
       style="width: 100%; background-color: #edf3f8; font-family: Arial, sans-serif; color: #17324a;">
  <tr>
    <td align="center" style="padding: 20px 8px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" bgcolor="#ffffff"
             style="width: 100%; max-width: 640px; background-color: #ffffff; border: 1px solid #d7e1ea; border-radius: 12px; border-spacing: 0;">
        <tr>
          <td bgcolor="#153650" style="padding: 22px 16px; background-color: #153650; color: #ffffff; border-radius: 11px 11px 0 0;">
            <h1 style="margin: 0; font-size: 24px; line-height: 30px;">Capacidad ocupada de canchas</h1>
            <p style="margin: 6px 0 0; color: #d5e6f4; font-size: 14px;"><%= @timestamp %> · Hora de Chile</p>
          </td>
        </tr>
        <tr>
          <td style="padding: 12px 12px 16px;">
            <table width="100%" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse; font-size: 14px; line-height: 20px;">
              <thead>
                <tr bgcolor="#e9f1f8" style="background-color: #e9f1f8; color: #244962;">
                  <th scope="col" align="left" style="padding: 9px 8px;">Material</th>
                  <th scope="col" colspan="2" align="right" style="padding: 9px 8px;">Ocupación</th>
                </tr>
              </thead>
              <tbody>
                <% EstadoCancha::MATERIALS.each do |field, name| %>
                  <% value = @estado_cancha[field] %>
                  <% bar_width = value.to_i.clamp(0, 100) %>
                  <tr>
                    <th scope="row" width="33%" align="left" style="padding: 8px; border-bottom: 1px solid #e3ebf2; font-weight: 600;"><%= name %></th>
                    <td width="48%" aria-hidden="true" style="padding: 8px 0; border-bottom: 1px solid #e3ebf2;">
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" bgcolor="#e3edf5"
                             style="width: 100%; background-color: #e3edf5; border-radius: 6px;">
                        <tr>
                          <td height="10" style="height: 10px; line-height: 10px; font-size: 1px;">
                            <% if bar_width.positive? %>
                              <table role="presentation" width="<%= bar_width %>%" cellpadding="0" cellspacing="0"
                                     bgcolor="#2875ad" style="width: <%= bar_width %>%; background-color: #2875ad; border-radius: 6px;">
                                <tr><td height="10" style="height: 10px; line-height: 10px; font-size: 1px;">&nbsp;</td></tr>
                              </table>
                            <% else %>
                              &nbsp;
                            <% end %>
                          </td>
                        </tr>
                      </table>
                    </td>
                    <td width="19%" align="right" style="padding: 8px; border-bottom: 1px solid #e3ebf2; white-space: nowrap; font-weight: 700; color: <%= value.nil? ? '#52677a' : '#17324a' %>;">
                      <%= value.nil? ? "Sin dato" : "#{value} %" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
            <% if @estado_cancha.observaciones.present? %>
              <div style="margin-top: 14px; padding: 12px; border-radius: 6px; background-color: #edf3f8;">
                <h2 style="margin: 0 0 4px; font-size: 15px;">Observaciones</h2>
                <p style="margin: 0; font-size: 14px; line-height: 20px; overflow-wrap: anywhere;"><%= safe_join(@estado_cancha.observaciones.lines(chomp: true), tag.br) %></p>
              </div>
            <% end %>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<% content_for :title, @page_title %>

<div class="mx-auto" style="max-width: 1800px;">
  <div class="bg-dark text-white rounded-4 p-4 mb-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
    <div>
      <h1 class="h4 fw-bold mb-1"><%= @page_title %></h1>
      <p class="mb-0 text-white-50"><%= @page_description %></p>
    </div>

    <div class="d-flex flex-wrap gap-2">
      <div class="dropdown">
        <button class="btn btn-outline-light fw-semibold dropdown-toggle" type="button" id="mantenciones-download-menu" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">Descargar Excel</button>
        <div class="dropdown-menu dropdown-menu-end p-3" style="width: min(24rem, calc(100vw - 2rem));" aria-labelledby="mantenciones-download-menu">
          <%= form_with url: descargar_mantenciones_path(format: :xlsx), method: :get, data: { turbo: false } do %>
            <div class="mb-3">
              <%= label_tag :mantenciones_download_specialty, "Especialidad", class: "form-label" %>
              <%= select_tag :especialidad, options_for_select([["Todas", "todas"], ["Mecánico", "mecanica"], ["Eléctrico", "electrica"]], @especialidad_filter || "todas"), id: "mantenciones_download_specialty", class: "form-select" %>
            </div>
            <div class="row g-2 mb-3">
              <div class="col-6">
                <%= label_tag :mantenciones_download_from, "Desde", class: "form-label" %>
                <%= date_field_tag :desde, @download_from, id: "mantenciones_download_from", required: true, class: "form-control" %>
              </div>
              <div class="col-6">
                <%= label_tag :mantenciones_download_to, "Hasta", class: "form-label" %>
                <%= date_field_tag :hasta, @download_to, id: "mantenciones_download_to", required: true, class: "form-control" %>
              </div>
            </div>
            <%= submit_tag "Descargar mantenciones", class: "btn btn-primary w-100" %>
          <% end %>
        </div>
      </div>
      <%= link_to "Detalle por área", area_mantenciones_path, class: "btn btn-outline-light fw-semibold", data: { turbo: false } %>
      <%= link_to "Ver gráficos",
                  graficos_mantenciones_path(especialidad: @especialidad_filter),
                  class: "btn btn-outline-light fw-semibold",
                  data: { turbo: false } %>
      <%= link_to "Nueva mantención",
                  new_mantencion_path(especialidad: @especialidad_filter),
                  class: "btn btn-light fw-semibold" %>
    </div>
  </div>

  <% if @download_error.present? %><div class="alert alert-danger" role="alert"><%= @download_error %></div><% end %>

  <%= form_with url: mantenciones_path, method: :get, class: "card border-0 shadow-sm rounded-4 mb-3", data: { turbo: false } do %>
    <% if @especialidad_filter.present? %>
      <%= hidden_field_tag :especialidad, @especialidad_filter %>
    <% end %>
    <%= hidden_field_tag :planificacion, @planning_filter if @planning_filter.present? %>
    <% if @pending_filter %>
      <%= hidden_field_tag :pendientes, "1" %>
    <% end %>

    <div class="card-body p-3">
      <div class="input-group">
        <%= search_field_tag :q,
                             @search_query,
                             class: "form-control",
                             placeholder: "Buscar por actividad, área, código, OT, comentarios o estado",
                             aria: { label: "Buscar mantenciones" } %>
        <button type="submit" class="btn btn-dark">Buscar</button>
        <% if @search_query.present? %>
          <%= link_to "Limpiar",
                      mantenciones_path(especialidad: @especialidad_filter, planificacion: @planning_filter, pendientes: (@pending_filter ? "1" : nil)),
                      class: "btn btn-outline-secondary" %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= render "records_table" %>

  <% if @pagy.pages > 1 %>
    <div class="d-flex justify-content-center mt-4">
      <%= pagy_bootstrap_nav(@pagy).html_safe %>
    </div>
  <% end %>
</div>

<% content_for :title, "Mantención #{@mantencion.numero_ot.presence || @mantencion.id}" %>

<div class="mx-auto" style="max-width: 1000px;">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
    <div>
      <h1 class="h4 fw-bold mb-1">Detalle de mantención</h1>
      <p class="text-body-secondary mb-0"><%= @mantencion.actividad %></p>
    </div>

    <div class="d-flex gap-2">
      <%= link_to "Editar", edit_mantencion_path(@mantencion), class: "btn btn-primary" %>
      <%= link_to "Volver", mantenciones_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
      <div class="row g-4">
        <% fields = [
          ["Semana", @mantencion.semana],
          ["Fecha", @mantencion.fecha&.strftime("%d-%m-%Y")],
          ["Especialidad", @mantencion.especialidad],
          ["Área", @mantencion.area],
          ["Código", @mantencion.codigo],
          ["Tipo de mantención", @mantencion.tipo_mantencion],
          ["Planificación", @mantencion.planificacion],
          ["Estado", @mantencion.estado.present? ? "#{number_with_precision(@mantencion.estado, precision: 2, strip_insignificant_zeros: true)}%" : nil],
          ["N° OT", @mantencion.numero_ot],
          ["Duración del trabajo", @mantencion.duracion.present? ? "#{number_with_precision(@mantencion.duracion, precision: 2, strip_insignificant_zeros: true)} horas" : nil]
        ] %>

        <% fields.each do |label, value| %>
          <div class="col-sm-6 col-lg-4">
            <div class="text-body-secondary small"><%= label %></div>
            <div class="fw-semibold"><%= value.presence || "—" %></div>
          </div>
        <% end %>

        <div class="col-12">
          <div class="text-body-secondary small">Actividad</div>
          <div class="fw-semibold text-break"><%= @mantencion.actividad %></div>
        </div>

        <div class="col-12">
          <div class="text-body-secondary small">Comentarios</div>
          <div class="text-break"><%= simple_format(@mantencion.comentarios.presence || "Sin comentarios", class: "mb-0") %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-3 text-end">
    <%= button_to "Eliminar mantención",
                  mantencion_path(@mantencion),
                  method: :delete,
                  class: "btn btn-outline-danger",
                  form: { data: { turbo_confirm: "¿Eliminar esta mantención?" } } %>
  </div>
</div>

workbook = xlsx_package.workbook
header = workbook.styles.add_style(b: true, fg_color: "FFFFFF", bg_color: "183153", alignment: { wrap_text: true })
date = workbook.styles.add_style(format_code: "dd/mm/yyyy")
amount = workbook.styles.add_style(format_code: "#,##0")

workbook.add_worksheet(name: "Cotizaciones", escape_formulas: true) do |sheet|
  sheet.add_row [ "Referencia", "Planta", "Descripción", "Solicitante", "Estado", "Fecha de término", "OP", "Factura",
                  "Centro de costo", "Total (CLP)", "Clasificación", "Observaciones", "Detalle", "Otros antecedentes", *record_author_labels ], style: header

  @trabajos.each do |trabajo|
    sheet.add_row [
      trabajo.referencia.to_s, nombre_planta_trabajo(trabajo.planta), trabajo.descripcion, trabajo.ito,
      estado_trabajo(trabajo.avance), trabajo.fecha_termino, trabajo.op, trabajo.factura, trabajo.centro_costo,
      trabajo.total, trabajo.supervisor, trabajo.observaciones, trabajo.detalle, trabajo.otros, *record_author_values(trabajo)
    ], types: [ :string, :string, :string, :string, :string, :date, :integer, :integer, :string, :integer,
                :string, :string, :string, :string, :string, :string ],
       style: [ nil, nil, nil, nil, nil, date, nil, nil, nil, amount ]
  end

  sheet.column_widths 15, 20, 50, 28, 20, 18, 14, 14, 18, 18, 22, 45, 45, 45, 32, 32
  sheet.auto_filter = "A1:P#{sheet.rows.size}"
  sheet.sheet_view.pane do |pane|
    pane.top_left_cell = "A2"
    pane.state = :frozen
    pane.y_split = 1
  end
end

workbook.add_worksheet(name: "Ítems", escape_formulas: true) do |sheet|
  sheet.add_row [ "Referencia", "N° de ítem", "Descripción", "Cantidad", "Precio unitario (CLP)", "Subtotal (CLP)" ], style: header

  @trabajos.each do |trabajo|
    Trabajo::ITEMS.each do |number|
      item, quantity, price = trabajo.values_at("i#{number}", "q#{number}", "v#{number}")
      next unless [ item, quantity, price ].any?(&:present?)

      sheet.add_row [ trabajo.referencia.to_s, number, item, quantity, price, trabajo.subtotal(number) ],
                    types: [ :string, :integer, :string, :integer, :integer, :integer ],
                    style: [ nil, nil, nil, nil, amount, amount ]
    end
  end

  sheet.column_widths 15, 14, 58, 14, 23, 19
  sheet.auto_filter = "A1:F#{sheet.rows.size}"
  sheet.sheet_view.pane do |pane|
    pane.top_left_cell = "A2"
    pane.state = :frozen
    pane.y_split = 1
  end
end

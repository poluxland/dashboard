<% content_for :title, "Trabajo #{@trabajo.referencia} · Impromaq" %>

<style>
  @media print {
    .navbar, .app-flash-stack { display: none !important; }
  }
</style>

<%= link_to "Volver a trabajos", trabajos_path, class: "d-inline-block d-print-none mb-2" %>

<div class="d-none d-print-block mb-3">
  <%= image_tag "impromaq-logo.png", alt: "Impromaq", width: 72, height: 72 %>
  <p class="mb-0"><strong>Servicios Industriales Impromaq Ltda.</strong></p>
  <p class="mb-0">Viana 345, depto. 14, Viña del Mar</p>
</div>

<div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3" data-controller="trabajo-print">
  <div>
    <p class="text-body-secondary mb-1">Cotización <%= @trabajo.referencia %></p>
    <h1 class="h3 mb-0"><%= @trabajo.descripcion.presence || "Sin descripción" %></h1>
  </div>
  <div class="d-print-none d-flex flex-wrap gap-2">
    <%= button_tag "Imprimir cotización", type: "button", class: "btn btn-outline-secondary", data: { action: "trabajo-print#print" } %>
    <%= link_to "Editar trabajo", edit_trabajo_path(@trabajo), class: "btn btn-outline-primary" %>
  </div>
</div>

<div class="card card-body mb-3">
  <dl class="row mb-0">
    <% fields = {
      "Planta" => nombre_planta_trabajo(@trabajo.planta),
      "Solicitante" => @trabajo.ito,
      "Fecha de cotización" => @trabajo.updated_at.in_time_zone("America/Santiago").strftime("%d/%m/%Y")
    } %>
    <% internos = {
      "Estado" => estado_trabajo(@trabajo.avance),
      "Centro de costo" => @trabajo.centro_costo,
      "Clasificación" => @trabajo.supervisor,
      "Fecha de término" => @trabajo.fecha_termino&.strftime("%d/%m/%Y"),
      "OP" => @trabajo.op,
      "Factura" => @trabajo.factura
    } %>
    <% fields.merge(internos).each do |label, value| %>
      <div class="col-6 col-md-3 <%= 'd-print-none' if internos.key?(label) %>">
        <dt><%= label %></dt>
        <dd><%= value.presence || "—" %></dd>
      </div>
    <% end %>
  </dl>
</div>

<section class="card card-body mb-3">
  <h2 class="h5">Ítems de la cotización</h2>
  <div class="table-responsive">
    <table class="table table-sm mb-0">
      <thead>
        <tr>
          <th scope="col">Descripción</th>
          <th scope="col" class="text-end">Cantidad</th>
          <th scope="col" class="text-end">Precio unitario</th>
          <th scope="col" class="text-end">Subtotal</th>
        </tr>
      </thead>
      <tbody>
        <% Trabajo::ITEMS.each do |number| %>
          <% item = @trabajo["i#{number}"]; quantity = @trabajo["q#{number}"]; price = @trabajo["v#{number}"] %>
          <% next unless [item, quantity, price].any?(&:present?) %>
          <tr>
            <td><%= item %></td>
            <td class="text-end"><%= quantity %></td>
            <td class="text-end text-nowrap"><%= monto_trabajo(price) if price %></td>
            <td class="text-end text-nowrap"><%= monto_trabajo(@trabajo.subtotal(number)) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <th scope="row" colspan="3" class="text-end">Total</th>
          <td class="text-end text-nowrap fw-semibold"><%= monto_trabajo(@trabajo.total) %></td>
        </tr>
      </tfoot>
    </table>
  </div>
</section>

<% { "Observaciones" => @trabajo.observaciones, "Detalle" => @trabajo.detalle, "Otros antecedentes" => @trabajo.otros }.each do |label, value| %>
  <% if value.present? %>
    <section class="card card-body mb-3 <%= 'd-print-none' if label == 'Detalle' %>">
      <h2 class="h5"><%= label %></h2>
      <div style="white-space: pre-wrap"><%= value %></div>
    </section>
  <% end %>
<% end %>

<div class="d-none d-print-block small">
  <p><strong>Validez de la oferta</strong> 15 días.</p>
  <p class="mb-1">El valor de la oferta considera</p>
  <ul>
    <li>Herramientas estándar y asociadas a la tarea</li>
    <li>Elementos de protección personal básicos y asociados a la tarea</li>
    <li>Supervisión y prevención de riesgos</li>
    <li>Planificación, evaluación y desarrollo de la tarea</li>
  </ul>
</div>

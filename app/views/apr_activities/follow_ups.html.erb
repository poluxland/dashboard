<% content_for :title, "Seguimientos · APR" %>
<header class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <h1 class="h3 mb-0">Seguimientos</h1>
  <%= link_to "Volver al registro", apr_activities_path(plant: @plant), class: "btn btn-outline-secondary" %>
</header>

<%= render "filters", path: follow_ups_apr_activities_path %>
<%= render "table", activities: @activities, follow_ups: true %>
<% if @pagy.pages > 1 %><nav class="mt-3" aria-label="Páginas de seguimientos"><%== pagy_bootstrap_nav(@pagy) %></nav><% end %>

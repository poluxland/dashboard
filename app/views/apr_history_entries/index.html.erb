<% content_for :title, "Histórico de actividades · APR" %>
<header class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <h1 class="h3 mb-0">Histórico de actividades</h1>
  <%= link_to "Volver al registro", apr_activities_path, class: "btn btn-outline-secondary" %>
</header>

<%= form_with url: apr_history_entries_path, method: :get, class: "row g-2 align-items-end mb-4" do %>
  <div class="col-6 col-md-auto">
    <%= label_tag :from, "Desde", class: "form-label mb-1" %>
    <%= date_field_tag :from, @from, class: "form-control" %>
  </div>
  <div class="col-6 col-md-auto">
    <%= label_tag :to, "Hasta", class: "form-label mb-1" %>
    <%= date_field_tag :to, @to, class: "form-control" %>
  </div>
  <div class="col-6 col-md-auto">
    <%= label_tag :plant, "Planta", class: "form-label mb-1" %>
    <%= select_tag :plant, options_for_select(apr_plant_options, @plant), include_blank: "Todas", class: "form-select" %>
  </div>
  <div class="col-8 col-md">
    <%= label_tag :q, "Buscar", class: "form-label mb-1" %>
    <%= search_field_tag :q, @query, placeholder: "Actividad, tipo, sector u observación", maxlength: 120, class: "form-control" %>
  </div>
  <div class="col-auto"><%= submit_tag "Consultar", class: "btn btn-outline-primary" %></div>
<% end %>

<% if @entries.any? %>
  <% form_labels = apr_history_form_fields({}).keys %>
  <p class="text-body-secondary small mb-2"><%= pluralize(@pagy.count, "fila", plural: "filas") %></p>
  <div class="table-responsive border rounded">
    <table class="table table-sm table-hover align-middle mb-0" aria-label="Actividades del histórico" data-table-export="off">
      <thead class="table-light">
        <tr>
          <th scope="col">Fecha</th><th scope="col">Planta</th>
          <% form_labels.first(2).each do |label| %>
            <th scope="col"><%= label %></th>
          <% end %>
          <th scope="col">Actividad</th><th scope="col">Observaciones</th>
          <% form_labels.drop(2).each do |label| %>
            <th scope="col"><%= label %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @entries.each do |entry| %>
          <tr>
            <% detail_path = entry.listed_position ? activity_apr_history_entry_path(entry, position: entry.listed_position) : apr_history_entry_path(entry) %>
            <td class="text-nowrap">
              <%= link_to apr_history_period(entry), detail_path, class: "fw-semibold" %>
            </td>
            <td><%= AprDay::PLANTS.fetch(entry.plant) %></td>
            <% fields = apr_history_form_fields(entry.listed_details || {}).values %>
            <% fields.first(2).each do |value| %><td><%= value %></td><% end %>
            <td class="apr-history-activity" style="min-width: 20rem">
              <%= render "expandable_text", text: entry.listed_activity.presence || entry.day_status %>
            </td>
            <td class="apr-history-observations" style="min-width: 15rem">
              <%= render "expandable_text", text: entry.listed_observations %>
            </td>
            <% fields.drop(2).each do |value| %><td class="text-break"><%= value %></td><% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @pagy.pages > 1 %><nav class="mt-3" aria-label="Páginas del histórico"><%== pagy_bootstrap_nav(@pagy) %></nav><% end %>
<% else %>
  <p class="text-body-secondary">No hay registros históricos para esta consulta.</p>
<% end %>

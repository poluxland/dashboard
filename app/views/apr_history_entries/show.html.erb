<% content_for :title, "Actividades históricas · APR" %>
<div class="mx-auto" style="max-width: 960px">
  <header class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
      <h1 class="h3 mb-1"><%= apr_history_period(@entry) %></h1>
      <p class="text-body-secondary mb-0"><%= AprDay::PLANTS.fetch(@entry.plant) %></p>
    </div>
    <%= link_to "Volver al histórico", apr_history_entries_path, class: "btn btn-outline-secondary" %>
  </header>
  <section class="card card-body mb-3">
    <h2 class="h5"><%= @position ? "Actividad" : "Actividades" %></h2>
    <% if @entry.activities.any? %>
      <ul class="mb-0">
        <% positions = @position ? [ @position ] : (1..@entry.activities.size) %>
        <% positions.each do |position| %>
          <% activity = @entry.activities.fetch(position - 1) %>
          <% fields = apr_history_form_fields(@entry.activity_details.fetch(position.to_s, {})).compact_blank %>
          <li class="text-break mb-3" id="actividad-<%= position %>">
            <p class="mb-1" style="white-space: pre-wrap"><%= activity %></p>
            <% if fields.any? %>
              <dl class="d-flex flex-wrap gap-3 small text-body-secondary mb-0">
                <% fields.each do |label, value| %>
                  <div><dt><%= label %></dt><dd class="mb-0"><%= value %></dd></div>
                <% end %>
              </dl>
            <% end %>
            <% if (observations = @entry.activity_observations(position)).present? %>
              <h3 class="h6 mt-3 mb-1">Observaciones</h3>
              <p class="mb-0" style="white-space: pre-wrap"><%= observations %></p>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-body-secondary mb-0"><%= @entry.day_status.presence || "No hay actividad registrada." %></p>
    <% end %>
  </section>
</div>

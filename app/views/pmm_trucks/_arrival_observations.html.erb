<% query = report.query %>
<section class="card shadow-sm" id="observaciones-camiones">
  <div class="card-body">
    <h2 class="h5">Comentarios y acciones</h2>
    <%= form_with url: arrivals_pmm_trucks_path(anchor: "observaciones-camiones"), method: :get, class: "row g-2 align-items-end mb-3" do |form| %>
      <% query.except(:observations, :q, :sort).each do |key, value| %>
        <% if value.is_a?(Array) %>
          <% value.each do |choice| %>
            <%= hidden_field_tag "#{key}[]", choice, id: nil %>
          <% end %>
        <% else %>
          <%= hidden_field_tag key, value, id: nil %>
        <% end %>
      <% end %>
      <div class="col-12 col-md-4">
        <%= form.label :q, "Buscar en observaciones", class: "form-label" %>
        <%= form.search_field :q, value: query[:q], maxlength: 120, placeholder: "Comentario, patente o materia prima", class: "form-control" %>
      </div>
      <div class="col-6 col-md-3">
        <%= form.label :observations, "Mostrar", class: "form-label" %>
        <%= form.select :observations, [["Con comentario", "comments"], ["Comentario o estado especial", "special"]],
                        { selected: query[:observations] }, class: "form-select" %>
      </div>
      <div class="col-6 col-md-3">
        <%= form.label :sort, "Ordenar por", class: "form-label" %>
        <%= form.select :sort, [["Mayor espera", "wait"], ["Más recientes", "recent"]],
                        { selected: query[:sort] }, class: "form-select" %>
      </div>
      <div class="col-auto">
        <%= form.submit "Buscar", class: "btn btn-outline-primary" %>
      </div>
    <% end %>

    <% if observations.any? %>
      <p class="small text-body-secondary mb-2"><%= number_with_delimiter(pagy.count) %> registros en la consulta de comentarios</p>
      <div class="table-responsive position-relative">
        <table class="table table-sm table-hover align-middle mb-0" aria-label="Comentarios de camiones">
          <thead class="table-light">
            <tr><th scope="col">Fecha</th><th scope="col">Ingreso</th><th scope="col">Salida</th>
              <th scope="col">Patente</th><th scope="col">Materia prima</th><th scope="col">Tipo</th>
              <th scope="col" class="text-end">Espera (min)</th><th scope="col">Estado</th><th scope="col">Comentario</th>
              <th scope="col"><span class="visually-hidden">Acciones</span></th><%= record_author_headers %></tr>
          </thead>
          <tbody>
            <% observations.each do |truck| %>
              <tr>
                <td class="text-nowrap"><%= l truck.fecha %></td>
                <td><%= pmm_time(truck.llegada) %></td><td><%= pmm_time(truck.salida).presence || "—" %></td>
                <td class="text-nowrap"><%= truck.patente.presence || "—" %></td><td><%= truck.pmm_material.nombre %></td>
                <td><%= truck.tipo.presence || "Sin registro" %></td>
                <td class="text-end"><%= truck.wait %></td><td><%= truck.cause.presence || "Sin registro" %></td>
                <td style="min-width: 14rem; white-space: pre-wrap;"><%= [truck.motive, truck.other].map { |value| value.to_s.strip.presence }.compact.join("\n").presence || "—" %></td>
                <td><%= link_to "Ver", pmm_truck_path(truck), class: "btn btn-sm btn-outline-secondary",
                                aria: { label: "Ver camión #{truck.patente}" }, data: { turbo_frame: "_top" } %></td>
                <%= record_author_cells(truck) %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if pagy.pages > 1 %><div class="mt-3"><%== pagy_bootstrap_nav(pagy) %></div><% end %>
    <% else %>
      <p class="text-body-secondary mb-0">No hay comentarios para esta consulta.</p>
    <% end %>
  </div>
</section>

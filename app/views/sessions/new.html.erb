<% content_for :title, "Ingresar" %>

<style>
  .login-page {
    min-height: calc(100vh - 2rem);
    display: grid;
    place-items: center;
    padding: 32px 16px;
    background: #f3f4f6;
  }

  .login-card {
    width: min(100%, 430px);
    padding: 34px;
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 18px 45px rgba(17, 24, 39, .12);
    text-align: center;
  }

  .login-brand {
    margin-bottom: 10px;
    color: #111827;
    font-size: 28px;
    font-weight: 800;
  }

  .login-copy {
    margin: 0 0 26px;
    color: #6b7280;
    line-height: 1.55;
  }

  .google-login-button {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px 16px;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    background: #fff;
    color: #111827;
    font-size: 15px;
    font-weight: 700;
  }

  .google-login-button:hover {
    background: #f9fafb;
  }

  .google-login-logo {
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
  }

  .login-domain {
    margin-top: 18px;
    color: #6b7280;
    font-size: 13px;
  }

  .login-pending {
    padding: 12px;
    border-radius: 10px;
    background: #fff7ed;
    color: #9a3412;
    font-size: 14px;
  }
</style>

<div class="login-page">
  <main class="login-card">
    <div class="login-brand">Impromaq</div>
    <p class="login-copy">Ingresa al dashboard con tu cuenta corporativa de Google Workspace.</p>

    <% if @google_oauth_configured %>
      <%= button_to "/auth/google_oauth2",
            method: :post,
            class: "google-login-button",
            data: { turbo: false } do %>
        <svg class="google-login-logo" aria-hidden="true" viewBox="0 0 18 18">
          <path fill="#4285F4" d="M17.64 9.205c0-.639-.057-1.252-.164-1.841H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.614Z"/>
          <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.258c-.806.54-1.837.859-3.048.859-2.344 0-4.329-1.585-5.037-3.71H.956v2.333C2.437 15.984 5.482 18 9 18Z"/>
          <path fill="#FBBC05" d="M3.963 10.711A5.41 5.41 0 0 1 3.68 9c0-.593.103-1.17.283-1.711V4.956H.956A9 9 0 0 0 0 9c0 1.455.348 2.83.956 4.044l3.007-2.333Z"/>
          <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.441 1.346l2.581-2.582C13.464.892 11.426 0 9 0 5.482 0 2.437 2.016.956 4.956l3.007 2.333C4.671 5.164 6.656 3.58 9 3.58Z"/>
        </svg>
        Continuar con Google
      <% end %>
    <% else %>
      <div class="login-pending">La autenticación de Google aún no está configurada.</div>
    <% end %>

    <div class="login-domain">Acceso exclusivo para cuentas @msindustrial.cl</div>
  </main>
</div>

<!-- app/views/people/_form.html.erb -->
<%= form_with(model: person, class: "needs-validation") do |f| %>
  <% if person.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% person.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control", autofocus: true %>
  </div>

  <div class="mb-3">
    <%= f.label :planta, class: "form-label" %>
    <%= f.select :planta,
          [["LCA", "LCA"], ["PTM", "PTM"], ["VTS", "VTS"]],
          { include_blank: "Selecciona planta" },
          class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= f.label :area, "Área", class: "form-label" %>
    <%= f.text_field :area, required: true, list: "person-areas", class: "form-control" %>
    <datalist id="person-areas"><% Person.distinct.order(:area).pluck(:area).compact_blank.each do |area| %><option value="<%= area %>"></option><% end %></datalist>
  </div>

  <div class="form-check mb-3">
    <%= f.check_box :indicator_enabled, class: "form-check-input" %>
    <%= f.label :indicator_enabled, "Participa en indicadores", class: "form-check-label" %>
    <div class="form-text">Activa esta opción solo para quienes se evalúan en indicadores. Todas las personas están disponibles para cierre de turno.</div>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Volver", people_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>

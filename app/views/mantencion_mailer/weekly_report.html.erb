<div style="margin:0;background:#f3f4f6;padding:24px 12px;font-family:Arial,Helvetica,sans-serif;color:#111827;">
  <div style="max-width:760px;margin:0 auto;background:#ffffff;border-radius:16px;overflow:hidden;">
    <div style="background:#111827;color:#ffffff;padding:28px;">
      <div style="font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#9ca3af;">Informe semanal</div>
      <h1 style="font-size:26px;line-height:1.25;margin:6px 0 8px;">Mantenciones · Semana <%= @report.week_number %></h1>
      <div style="font-size:15px;color:#d1d5db;">
        <%= l(@report.start_date, format: :long) %> al <%= l(@report.end_date, format: :long) %>
      </div>
    </div>

    <div style="padding:24px 28px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="8" style="border-collapse:separate;margin:0 -8px 24px;">
        <tr>
          <td width="25%" style="background:#eff6ff;border-radius:10px;padding:14px;vertical-align:top;">
            <div style="font-size:12px;color:#64748b;">Mantenciones</div>
            <div style="font-size:24px;font-weight:700;color:#1e3a8a;"><%= number_with_delimiter(@report.total) %></div>
          </td>
          <td width="25%" style="background:#f0fdf4;border-radius:10px;padding:14px;vertical-align:top;">
            <div style="font-size:12px;color:#64748b;">Planificado</div>
            <div style="font-size:24px;font-weight:700;color:#166534;"><%= @report.planned_percentage ? "#{number_with_precision(@report.planned_percentage, precision: 1)}%" : "—" %></div>
          </td>
          <td width="25%" style="background:#fffbeb;border-radius:10px;padding:14px;vertical-align:top;">
            <div style="font-size:12px;color:#64748b;">No programado</div>
            <div style="font-size:24px;font-weight:700;color:#92400e;"><%= @report.unplanned_percentage ? "#{number_with_precision(@report.unplanned_percentage, precision: 1)}%" : "—" %></div>
          </td>
          <td width="25%" style="background:#faf5ff;border-radius:10px;padding:14px;vertical-align:top;">
            <div style="font-size:12px;color:#64748b;">Estado promedio</div>
            <div style="font-size:24px;font-weight:700;color:#6b21a8;"><%= @report.average_state ? "#{number_with_precision(@report.average_state, precision: 1)}%" : "—" %></div>
          </td>
        </tr>
      </table>

      <% if @report.total.zero? %>
        <div style="padding:18px;background:#eff6ff;color:#1e40af;border-radius:10px;">No se registraron mantenciones durante esta semana.</div>
      <% else %>
        <% @report.chart_groups.each do |chart| %>
          <div style="border:1px solid #e5e7eb;border-radius:12px;padding:18px;margin-bottom:18px;">
            <h2 style="font-size:17px;margin:0 0 14px;"><%= chart[:title] %></h2>

            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
              <% chart[:rows].each do |row| %>
                <tr>
                  <td style="padding:6px 10px 6px 0;width:34%;font-size:13px;vertical-align:middle;"><%= row[:label] %></td>
                  <td style="padding:6px 10px 6px 0;vertical-align:middle;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;background:#e5e7eb;border-radius:5px;overflow:hidden;">
                      <tr>
                        <td width="<%= row[:percentage] %>%" height="12" style="background:<%= row[:color] %>;font-size:0;line-height:0;">&nbsp;</td>
                        <td height="12" style="font-size:0;line-height:0;">&nbsp;</td>
                      </tr>
                    </table>
                  </td>
                  <td style="padding:6px 0;width:72px;text-align:right;font-size:13px;font-weight:700;vertical-align:middle;">
                    <%= number_with_precision(row[:value], precision: 1, strip_insignificant_zeros: true) %><%= row[:suffix] %>
                  </td>
                </tr>
              <% end %>
            </table>
          </div>
        <% end %>

        <div style="border:1px solid #e5e7eb;border-radius:12px;padding:18px;margin-bottom:18px;">
          <h2 style="font-size:17px;margin:0 0 4px;">Tareas de la semana</h2>
          <p style="font-size:13px;color:#64748b;margin:0 0 14px;">Detalle de las <%= @report.total %> mantenciones y su porcentaje de cumplimiento.</p>

          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
            <% @report.records.each_with_index do |record, index| %>
              <%
                completion_label = record.estado.nil? ? "Sin estado" : "#{number_with_precision(record.estado, precision: 1, strip_insignificant_zeros: true)}%"
                completion_color = if record.estado.nil?
                  "#64748b"
                elsif record.estado >= 100
                  "#166534"
                elsif record.estado.positive?
                  "#92400e"
                else
                  "#991b1b"
                end
              %>
              <tr>
                <td style="padding:12px 8px 12px 0;border-top:<%= index.zero? ? 0 : 1 %>px solid #e5e7eb;vertical-align:top;width:72px;font-size:12px;color:#64748b;white-space:nowrap;">
                  <%= l(record.fecha, format: :short) %>
                </td>
                <td style="padding:12px 8px;border-top:<%= index.zero? ? 0 : 1 %>px solid #e5e7eb;vertical-align:top;">
                  <div style="font-size:14px;font-weight:700;line-height:1.35;"><%= record.actividad %></div>
                  <div style="font-size:12px;color:#64748b;margin-top:4px;line-height:1.4;">
                    <%= [record.especialidad, record.area.presence && "Área #{record.area}", record.numero_ot.presence && "OT #{record.numero_ot}"].compact.join(" · ") %>
                  </div>
                  <div style="font-size:12px;color:#475569;margin-top:4px;line-height:1.4;">
                    <strong>Comentarios:</strong> <%= record.comentarios.presence || "Sin comentarios" %>
                  </div>
                </td>
                <td style="padding:12px 0 12px 8px;border-top:<%= index.zero? ? 0 : 1 %>px solid #e5e7eb;vertical-align:top;width:74px;text-align:right;white-space:nowrap;">
                  <span style="display:inline-block;background:<%= completion_color %>;color:#ffffff;border-radius:999px;padding:5px 8px;font-size:12px;font-weight:700;"><%= completion_label %></span>
                </td>
              </tr>
            <% end %>
          </table>
        </div>
      <% end %>

      <div style="text-align:center;padding-top:6px;">
        <%= link_to "Ver gráficos en Dashboard",
                    graficos_mantenciones_url(year: @report.end_date.year, semana: @report.week_number),
                    style: "display:inline-block;background:#2563eb;color:#ffffff;text-decoration:none;font-weight:700;padding:12px 18px;border-radius:8px;" %>
      </div>
    </div>
  </div>
</div>

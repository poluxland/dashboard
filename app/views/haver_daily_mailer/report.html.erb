<div style="max-width: 760px; margin: 0 auto; color: #20342d; font: 15px/1.5 Arial, sans-serif">
  <div style="padding: 18px 20px; background: #eaf3ee; border-left: 4px solid #245a46">
    <h1 style="font-size: 22px; margin: 0 0 3px"><%= @title %></h1>
    <p style="margin: 0">Corte <%= @cutoff_label %> · hora de Chile</p>
  </div>
  <% if @test %><p><strong>Correo de prueba.</strong></p><% end %>

  <h2 style="font-size: 17px; margin-bottom: 6px">Tres turnos anteriores</h2>
  <p style="margin: 0 0 8px"><%= @report.shifts.count { |shift| shift[:received] } %> de 3 reportes disponibles al corte.</p>
  <table id="haver-email-turnos" style="width: 100%; border-collapse: collapse; margin-bottom: 16px; font-size: 13px">
    <thead>
      <tr style="background: #f2f6f4">
        <th scope="col" style="padding: 7px; text-align: left">Indicador</th>
        <% @report.shifts.each do |shift| %>
          <th scope="col" style="padding: 7px; text-align: right">
            <%= EnvasadoraReport::SHIFTS.fetch(shift[:shift]) %><br>
            <%= shift[:date].strftime("%d/%m") %>
          </th>
        <% end %>
        <th scope="col" style="padding: 7px; text-align: right; background: #eaf3ee">
          <%= @report.full_day[:label] %><br>
          <%= @report.full_day[:range].begin.strftime("%d/%m") %>
        </th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row" style="padding: 7px; text-align: left; border-bottom: 1px solid #dee8e1">Estado al corte</th>
        <% @report.shifts.each do |shift| %>
          <td style="padding: 7px; text-align: right; border-bottom: 1px solid #dee8e1"><%= shift[:status] %></td>
        <% end %>
        <td style="padding: 7px; text-align: right; border-bottom: 1px solid #dee8e1; background: #f2f7f4"><%= @report.full_day[:coverage] %></td>
      </tr>
      <% HaverDailyReport::SHIFT_METRICS.each do |label, key, unit, precision| %>
        <tr>
          <th scope="row" style="padding: 6px; text-align: left; border-bottom: 1px solid #dee8e1"><%= label %></th>
          <% @report.shifts.each do |shift| %>
            <td style="padding: 6px; text-align: right; border-bottom: 1px solid #dee8e1"><%= dashboard_number(shift[key], suffix: unit, precision: precision) %></td>
          <% end %>
          <td style="padding: 6px; text-align: right; border-bottom: 1px solid #dee8e1; background: #f2f7f4; font-weight: 600"><%= dashboard_number(@report.full_day[:totals][key], suffix: unit, precision: precision) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% @report.shifts.select { |shift| shift[:comment].present? }.each do |shift| %>
    <p style="margin: 6px 0; font-size: 13px"><strong><%= shift[:shift] %> <%= shift[:date].strftime("%d/%m") %></strong> · <%= shift[:comment] %></p>
  <% end %>

  <h2 style="font-size: 17px; margin-bottom: 6px">Producción y rendimiento</h2>
  <p style="font-size: 13px; color: #51615b; margin: 0 0 6px">
    Del <%= @report.production_range.begin.strftime("%d/%m") %> al <%= @report.production_range.end.strftime("%d/%m") %> · días con producción Haver
  </p>
  <% if @production_chart_url %>
    <%= image_tag @production_chart_url, width: 720,
                  alt: "Gráfico de producción diaria en toneladas y rendimiento en toneladas por hora",
                  style: "display: block; width: 100%; max-width: 720px; height: auto; border: 0; margin-bottom: 16px" %>
  <% elsif @report.production_data? %>
    <table style="width: 100%; border-collapse: collapse; margin-bottom: 16px; font-size: 13px">
      <thead>
        <tr style="background: #f2f6f4">
          <th scope="col" style="padding: 6px; text-align: left">Fecha</th>
          <th scope="col" style="padding: 6px; text-align: right">Producción (t)</th>
          <th scope="col" style="padding: 6px; text-align: right">Rendimiento (t/h)</th>
        </tr>
      </thead>
      <tbody>
        <% @report.production_by_day.each do |day| %>
          <tr>
            <th scope="row" style="padding: 6px; text-align: left; border-bottom: 1px solid #dee8e1"><%= day[:date].strftime("%d/%m") %></th>
            <td style="padding: 6px; text-align: right; border-bottom: 1px solid #dee8e1"><%= dashboard_number(day[:tons]) %></td>
            <td style="padding: 6px; text-align: right; border-bottom: 1px solid #dee8e1"><%= dashboard_number(day[:rate]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p style="font-size: 13px">Sin producción Haver informada en este período.</p>
  <% end %>

  <h2 style="font-size: 17px; margin-bottom: 6px">Pareto de detenciones Haver · últimos 30 días</h2>
  <p style="font-size: 13px; color: #51615b; margin: 0 0 6px">
    Del <%= @report.pareto_range.begin.strftime("%d/%m") %> al <%= @report.pareto_range.end.strftime("%d/%m") %> · detenciones con causa informada en turnos con producción Haver
    <% if @report.pareto_last_date %><br>Último día con detenciones consideradas <%= @report.pareto_last_date.strftime("%d/%m") %>.<% end %>
  </p>
  <% if @pareto_chart_url %>
    <%= image_tag @pareto_chart_url, width: 720,
                  alt: "Pareto Haver de minutos detenidos por causa y porcentaje acumulado",
                  style: "display: block; width: 100%; max-width: 720px; height: auto; border: 0; margin-bottom: 16px" %>
  <% elsif @report.pareto_causes.any? %>
    <table style="width: 100%; border-collapse: collapse; margin-bottom: 16px; font-size: 13px">
      <thead>
        <tr style="background: #f2f6f4">
          <th scope="col" style="padding: 6px; text-align: left">Causa</th>
          <th scope="col" style="padding: 6px; text-align: right">Minutos</th>
          <th scope="col" style="padding: 6px; text-align: right">% acumulado</th>
        </tr>
      </thead>
      <tbody>
        <% @report.pareto_causes.each do |cause| %>
          <tr>
            <th scope="row" style="padding: 6px; text-align: left; border-bottom: 1px solid #dee8e1"><%= cause[:label] %></th>
            <td style="padding: 6px; text-align: right; border-bottom: 1px solid #dee8e1"><%= dashboard_number(cause[:minutes]) %></td>
            <td style="padding: 6px; text-align: right; border-bottom: 1px solid #dee8e1"><%= dashboard_number(cause[:cumulative], suffix: "%") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p style="font-size: 13px">Sin detenciones con causa informada en este período.</p>
  <% end %>

  <h2 style="font-size: 17px; margin-bottom: 6px">KPI acumulados</h2>
  <table id="haver-email-acumulados" style="width: 100%; border-collapse: collapse; margin-bottom: 14px; font-size: 13px">
    <thead>
      <tr style="background: #f2f6f4">
        <th scope="col" style="padding: 7px; text-align: left">Indicador</th>
        <% @report.periods.each do |period| %>
          <th scope="col" style="padding: 7px; text-align: right<%= '; background: #eaf3ee' if period[:coverage] %>">
            <%= period[:label] %><br>
            <% if period[:coverage] %>
              <%= period[:range].begin.strftime("%d/%m") %><br>
              <small><%= period[:coverage] %></small>
            <% else %>
              <%= period[:range].begin.strftime("%d/%m") %>–<%= period[:range].end.strftime("%d/%m") %>
            <% end %>
          </th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% HaverDailyReport::TOTAL_METRICS.each do |label, key, unit, precision| %>
        <tr>
          <th scope="row" style="padding: 6px; text-align: left; border-bottom: 1px solid #dee8e1"><%= label %></th>
          <% @report.periods.each do |period| %>
            <td style="padding: 6px; text-align: right; border-bottom: 1px solid #dee8e1<%= '; background: #f2f7f4; font-weight: 600' if period[:coverage] %>"><%= dashboard_number(period[:totals][key], suffix: unit, precision: precision) %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p style="color: #51615b; font-size: 13px">Ideal Haver <%= dashboard_number(@report.ideal, suffix: " t/h") %>. El guion indica un dato ausente o un indicador que no se puede calcular. Los acumulados usan los reportes disponibles al corte.</p>
  <p style="margin: 20px 0">
    <%= link_to "Ver Informe Haver", haver_dashboard_url,
                style: "display: inline-block; padding: 11px 18px; background: #245a46; color: #fff; border-radius: 6px; text-decoration: none; font-weight: bold" %>
  </p>
</div>

<%= @title %>
<%= @period %> · Hora de Chile
<% if @rows.empty? %>
No se registraron checklists en este período.
<% end %>
<% @rows.each do |row| %>
<% score = row.score && number_to_percentage(row.score, precision: 1, separator: ",", strip_insignificant_zeros: true) %>
<%= row.equipment %> · <%= row.checked_at.strftime("%d/%m/%Y %H:%M") %> · Horómetro <%= row.hour_meter || "—" %> · Puntaje <%= score || "—" %>
Graves (<%= row.severe.size %>): <%= row.severe.join(", ").presence || "—" %>
Leves (<%= row.minor.size %>): <%= row.minor.join(", ").presence || "—" %>
Comentarios: <%= row.comments.presence || "—" %>
<% end %>

<% content_for :title, "Materia Prima" %>
<section class="container-xl py-4">
  <header class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
      <h1 class="h2 mb-1">Materia Prima</h1>
      <p class="text-body-secondary mb-0">Estado de canchas</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <%= link_to "Ver historial", historial_estado_canchas_path, class: "btn btn-outline-secondary" %>
      <%= link_to "Registrar estado", new_estado_cancha_path, class: "btn btn-primary" %>
    </div>
  </header>

  <% if @latest %>
    <% materials = EstadoCancha::MATERIALS %>
    <% series = {
      labels: materials.values,
      latest: materials.keys.map { |field| @latest[field] },
      trend: @trend.map { |record| { date: record.local_timestamp.strftime("%d/%m/%Y %H:%M"), values: materials.keys.map { |field| record[field] } } }
    } %>
    <div class="row g-3 mb-4" data-controller="estado-canchas"
         data-estado-canchas-series-value="<%= series.to_json %>">
      <p hidden class="alert alert-warning mb-0" data-estado-canchas-target="error">No se pudieron cargar los gráficos. Puedes consultar los valores en la tabla.</p>
      <section class="col-lg-6">
        <div class="card card-body h-100">
          <h2 class="h5 mb-1">Ocupación por material</h2>
          <p class="text-body-secondary small">
            <%= link_to @latest.local_timestamp.strftime("%d/%m/%Y %H:%M"), @latest %> · Hora de Chile
          </p>
          <div style="height: 430px;">
            <canvas role="img" aria-label="Porcentaje de ocupación en el último registro" data-estado-canchas-target="occupancy"></canvas>
          </div>
        </div>
      </section>

      <section class="col-lg-6">
        <div class="card card-body h-100">
          <h2 class="h5">Evolución por material</h2>
          <div class="mb-2">
            <label class="form-label" for="cancha-material">Material</label>
            <%= select_tag "cancha-material", options_for_select(materials.values.each_with_index.map { |name, index| [name, index] }),
                           class: "form-select", data: { estado_canchas_target: "material", action: "change->estado-canchas#updateTrend" } %>
          </div>
          <p class="text-body-secondary small">Últimos <%= @trend.size %> registros</p>
          <div style="height: 342px;">
            <canvas role="img" aria-label="Evolución del porcentaje de ocupación" data-estado-canchas-target="trend"></canvas>
          </div>
        </div>
      </section>
    </div>
  <% end %>

  <section class="card card-body">
    <h2 class="h5">Registros recientes</h2>
    <%= render "table", records: @estado_canchas %>
  </section>
</section>

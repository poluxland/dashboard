<% content_for :title, "Estado de canchas" %>
<section class="container-lg py-4">
  <header class="d-flex flex-wrap justify-content-between gap-3 mb-4">
    <div>
      <h1 class="h2 mb-1">Estado de canchas</h1>
      <p class="text-body-secondary mb-0"><%= @estado_cancha.local_timestamp.strftime("%d/%m/%Y %H:%M") %> · Hora de Chile</p>
    </div>
    <div class="d-flex flex-wrap align-items-start gap-2">
      <%= link_to "Historial", historial_estado_canchas_path, class: "btn btn-outline-secondary" %>
      <%= link_to "Editar", edit_estado_cancha_path(@estado_cancha), class: "btn btn-primary" %>
    </div>
  </header>
  <dl class="row g-3 mb-4">
    <% EstadoCancha::MATERIALS.each do |field, name| %>
      <div class="col-6 col-md-4 col-lg-3">
        <div class="card card-body h-100">
          <dt class="text-body-secondary"><%= name %></dt>
          <% value = @estado_cancha[field] %>
          <dd class="fs-5 mb-0"><%= value.nil? ? "—" : "#{value} %" %></dd>
        </div>
      </div>
    <% end %>
  </dl>
  <h2 class="h5">Observaciones</h2>
  <p style="white-space: pre-wrap;"><%= @estado_cancha.observaciones.presence || "—" %></p>
  <%= button_to "Eliminar registro", @estado_cancha, method: :delete, class: "btn btn-outline-danger mt-2",
                form: { data: { turbo_confirm: "¿Eliminar este estado de canchas?" } } %>
</section>

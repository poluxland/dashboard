<% if records.any? %>
  <div class="table-responsive mt-2">
    <table class="table table-hover table-sm align-middle">
      <thead>
        <tr>
          <th scope="col" class="text-nowrap">Fecha y hora</th>
          <% EstadoCancha::MATERIALS.each_value do |name| %>
            <th scope="col" class="text-end"><%= name %></th>
          <% end %>
          <th scope="col">Observaciones</th>
        </tr>
      </thead>
      <tbody>
        <% records.each do |record| %>
          <tr id="<%= dom_id(record) %>">
            <th scope="row" class="text-nowrap"><%= link_to record.local_timestamp.strftime("%d/%m/%Y %H:%M"), record %></th>
            <% EstadoCancha::MATERIALS.each_key do |field| %>
              <% value = record[field] %>
              <td class="text-end text-nowrap"><%= value.nil? ? "—" : "#{value} %" %></td>
            <% end %>
            <td style="min-width: 12rem; white-space: pre-wrap;"><%= record.observaciones.presence || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-body-secondary mb-0">Sin registros para mostrar.</p>
<% end %>

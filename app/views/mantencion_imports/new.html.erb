<% content_for :title, "Importar mantenciones" %>

<div class="mx-auto" style="max-width: 900px;">
  <div class="bg-dark text-white rounded-4 p-4 mb-3">
    <h1 class="h4 fw-bold mb-1">Importar mantenciones</h1>
    <p class="mb-0 text-white-50">Carga única del informe de ejecución desde Excel</p>
  </div>

  <% if @result.present? %>
    <div class="card border-0 shadow-sm rounded-4 mb-3">
      <div class="card-body p-4">
        <h2 class="h5 fw-bold">Resultado de la importación</h2>
        <p class="text-body-secondary"><%= @filename %></p>

        <div class="row g-3 mb-3">
          <div class="col-sm-6 col-lg">
            <div class="border rounded-3 p-3 h-100">
              <div class="small text-body-secondary">Creadas</div>
              <div class="h3 text-success mb-0"><%= @result.created %></div>
            </div>
          </div>
          <div class="col-sm-6 col-lg">
            <div class="border rounded-3 p-3 h-100">
              <div class="small text-body-secondary">Duplicadas</div>
              <div class="h3 text-primary mb-0"><%= @result.duplicates %></div>
            </div>
          </div>
          <div class="col-sm-6 col-lg">
            <div class="border rounded-3 p-3 h-100">
              <div class="small text-body-secondary">Vacías omitidas</div>
              <div class="h3 text-secondary mb-0"><%= @result.skipped %></div>
            </div>
          </div>
          <div class="col-sm-6 col-lg">
            <div class="border rounded-3 p-3 h-100">
              <div class="small text-body-secondary">Semana corregida</div>
              <div class="h3 text-warning mb-0"><%= @result.corrected %></div>
            </div>
          </div>
          <div class="col-sm-6 col-lg">
            <div class="border rounded-3 p-3 h-100">
              <div class="small text-body-secondary">Con error</div>
              <div class="h3 text-danger mb-0"><%= @result.errors.size %></div>
            </div>
          </div>
        </div>

        <% if @result.errors.any? %>
          <div class="alert alert-warning mb-3">
            <p class="fw-semibold mb-2">Filas que requieren revisión:</p>
            <ul class="mb-0">
              <% @result.errors.first(20).each do |error| %>
                <li><%= error %></li>
              <% end %>
            </ul>
            <% if @result.errors.size > 20 %>
              <p class="mb-0 mt-2">Y <%= @result.errors.size - 20 %> errores adicionales.</p>
            <% end %>
          </div>
        <% end %>

        <div class="d-flex flex-wrap gap-2">
          <%= link_to "Ver mantenciones", mantenciones_path, class: "btn btn-primary" %>
          <%= link_to "Ver eléctricas", mantenciones_path(especialidad: "electrica"), class: "btn btn-outline-primary" %>
        </div>
      </div>
    </div>
  <% end %>

  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
      <h2 class="h5 fw-bold">Seleccionar archivo</h2>
      <p class="text-body-secondary">
        El archivo debe conservar las 12 columnas y el mismo orden del informe original.
        Las filas vacías se omiten y las filas ya importadas no se duplican.
      </p>

      <%= form_with url: mantencion_import_path, method: :post, multipart: true, data: { turbo: false } do |form| %>
        <div class="mb-3">
          <%= form.label :archivo, "Archivo Excel", class: "form-label fw-semibold" %>
          <%= form.file_field :archivo,
                              accept: ".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                              required: true,
                              class: "form-control" %>
          <div class="form-text">Formato XLSX, máximo 10 MB.</div>
        </div>

        <div class="form-check mb-4">
          <%= check_box_tag :confirmar, "1", false, class: "form-check-input", required: true %>
          <%= label_tag :confirmar,
                        "Confirmo que deseo incorporar estos registros a Mantenciones.",
                        class: "form-check-label" %>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <%= form.submit "Importar archivo", class: "btn btn-primary fw-semibold" %>
          <%= link_to "Cancelar", root_path, class: "btn btn-outline-secondary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
